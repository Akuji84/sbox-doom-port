<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<SboxInstallDir Condition="'$(SboxInstallDir)' == ''">../../../../../../../Program Files (x86)/Steam/steamapps/common/sbox</SboxInstallDir>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>my_project_1</AssemblyName>
		<PackageId>my_project_1</PackageId>
		<LangVersion>14</LangVersion>
		<NoWarn>1701;1702;1591;</NoWarn>
		<WarningsAsErrors></WarningsAsErrors>
		<TreatWarningsAsErrors>False</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DefineConstants>SANDBOX</DefineConstants>
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<OutputPath>$(SboxInstallDir)/.vs/output/</OutputPath>
		<DocumentationFile>$(SboxInstallDir)/.vs/output/my_project_1.xml</DocumentationFile>
		<RootNamespace>Sandbox</RootNamespace>
		<Nullable>disable</Nullable>
		<DefaultItemExcludes>$(DefaultItemExcludes);**/editor/**;**/unittest/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
		<Using Include="Microsoft.AspNetCore.Components" />
		<Using Include="Microsoft.AspNetCore.Components.Rendering" />
	</ItemGroup>

	<ItemGroup>
		<Analyzer Include="$(SboxInstallDir)/bin/managed/Sandbox.CodeUpgrader.dll"/> 
		<Analyzer Include="$(SboxInstallDir)/bin/managed/Sandbox.Generator.dll"/> 
		<Reference Include="$(SboxInstallDir)/bin/managed/Sandbox.System.dll"/> 
		<Reference Include="$(SboxInstallDir)/bin/managed/Sandbox.Engine.dll"/> 
		<Reference Include="$(SboxInstallDir)/bin/managed/Sandbox.Filesystem.dll"/> 
		<Reference Include="$(SboxInstallDir)/bin/managed/Sandbox.Reflection.dll"/> 
		<Reference Include="$(SboxInstallDir)/bin/managed/Sandbox.Mounting.dll"/> 
		<Reference Include="$(SboxInstallDir)/bin/managed/Microsoft.AspNetCore.Components.dll"/> 
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(SboxInstallDir)/addons/base/code/Base Library.csproj" />
	</ItemGroup>

</Project>
