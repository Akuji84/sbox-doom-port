@using System
@using ManagedDoom
@using Sandbox.UI
@inherits PanelComponent

<root style="position: absolute; width: 100%; height: 100%; background-color: black; flex-direction: column; align-items: center; justify-content: center;">
    @if ( _texture is not null )
    {
        <Image Texture="@_texture" style="width: 80%; height: 80%; image-rendering: pixelated;" />
    }
    <div style="color: white; font-size: 18px; padding: 12px;">@_message</div>
    <SboxManagedDoomLicenses />
</root>

@code {
    [Property] public string WadPath { get; set; } = "doom/blasphem.wad";
    [Property] public int Episode { get; set; } = 1;
    [Property] public int Map { get; set; } = 1;
    [Property] public bool Navigation { get; set; } = true;
    [Property] public bool TestFlight { get; set; }
    private HereticWorldSession _session;
    private float _tickRemainder;
    [Property] public float Yaw { get; set; }
    private GameContent _content;
    private HereticMapPreview _preview;
    private global::Sandbox.Texture _texture;
    private readonly byte[] _pixels = new byte[HereticMapPreview.Width * HereticMapPreview.Height * 4];
    private string _message = "Loading Heretic geometry preview...";
    private float _elapsed;
    private int _lastTic = -1;
    private float _lastYaw = float.NaN;

    protected override void OnStart()
    {
        try
        {
            _content = GameContent.CreateHereticPreview(WadPath);
            if (Navigation)
            {
                _session = new HereticWorldSession(_content, Episode, Map);
                _preview = new HereticMapPreview(_content, _session);
            }
            else _preview = new HereticMapPreview(_content, Episode, Map);
            _texture = global::Sandbox.Texture.Create(HereticMapPreview.Width, HereticMapPreview.Height, ImageFormat.RGBA8888)
                .WithDynamicUsage().Finish();
            _message = _preview.Report;
        }
        catch (Exception ex)
        {
            _content?.Dispose();
            _content = null;
            _preview = null;
            _message = "Heretic preview: " + ex.Message;
        }
        StateHasChanged();
    }

    protected override void OnUpdate()
    {
        if (_preview is null) return;
        try
        {
            _elapsed += Time.Delta;
            var tic = (int)(_elapsed * 35);
            if (_session is not null)
            {
                _tickRemainder += Math.Min(Time.Delta, 0.25f);
                while (_tickRemainder >= 1f / 35f)
                {
                    if (TestFlight) _session.GrantFlight(2);
                    _session.Tick(new HereticCommand {
                        Forward = (sbyte)((Input.Keyboard.Down("W") ? 1 : 0) * 25 - (Input.Keyboard.Down("S") ? 1 : 0) * 25),
                        Side = (sbyte)((Input.Keyboard.Down("D") ? 1 : 0) * 24 - (Input.Keyboard.Down("A") ? 1 : 0) * 24),
                        Turn = (short)((Input.Keyboard.Down("LEFT") ? 640 : 0) - (Input.Keyboard.Down("RIGHT") ? 640 : 0)),
                        Look = (sbyte)((Input.Keyboard.Down("UP") ? 1 : 0) - (Input.Keyboard.Down("DOWN") ? 1 : 0)),
                        Fly = (sbyte)((Input.Keyboard.Down("R") ? 1 : 0) - (Input.Keyboard.Down("F") ? 1 : 0)),
                        Use = Input.Keyboard.Down("E"), CenterLook = Input.Keyboard.Down("HOME"), Land = Input.Keyboard.Down("END")
                    });
                    _tickRemainder -= 1f / 35f;
                }
                _message = "Navigation test: WASD move; arrows turn/look; E use; Home center; R/F fly (Test Flight); End land. " +
                    "Health " + _session.State.Health + "; keys " + _session.State.Keys + ". " + _session.State.Message +
                    " Combat, other actors, audio, inventory, campaign, saves and multiplayer are not active.";
                StateHasChanged();
            }
            if (tic == _lastTic && Yaw == _lastYaw) return;
            _preview.Render(_pixels, tic, Yaw);
            _texture.Update(_pixels, 0, 0, HereticMapPreview.Width, HereticMapPreview.Height);
            _lastTic = tic;
            _lastYaw = Yaw;
        }
        catch (Exception ex)
        {
            _preview = null;
            _message = "Heretic preview: " + ex.Message;
            StateHasChanged();
        }
    }

    protected override void OnDestroy()
    {
        _preview = null;
        _texture?.Dispose();
        _content?.Dispose();
        base.OnDestroy();
    }
}
