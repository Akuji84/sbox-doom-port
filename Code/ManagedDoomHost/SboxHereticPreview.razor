@* s&Doom modification: 2026-09-29, optional right-button frame-sampled mouse turning. *@
@* s&Doom modification: 2026-09-29, local preview pause and input reset. *@
@* s&Doom modification: 2026-09-29, map/intermission music through shared MUS/MIDI playback. *@
@* s&Doom modification: 2026-09-29, death restart and release-gated transition input. *@
@* s&Doom modification: 2026-09-29, preview campaign completion and transactional host replacement. *@
@using System
@using ManagedDoom
@using Sandbox.UI
@inherits PanelComponent

<root style="position: absolute; width: 100%; height: 100%; background-color: black; flex-direction: column; align-items: center; justify-content: center;">
    @if ( _texture is not null )
    {
        <Image Texture="@_texture" style="width: 80%; height: 80%; image-rendering: pixelated;" />
    }
    <div style="color: white; font-size: 18px; padding: 12px;">@_message</div>
    @if (_session?.Completion is HereticCampaignExit completed)
    {
        <div style="position: absolute; background-color: #111e; padding: 24px; color: white; flex-direction: column; align-items: center; pointer-events: all;">
            <div style="font-size: 28px;">@(completed.Kind == HereticExitKind.EpisodeComplete ? "Episode complete" : "Level complete")</div>
            <div>E@(completed.Episode)M@(completed.Map) · Time @(completed.ElapsedTics / 35 / 60):@((completed.ElapsedTics / 35 % 60).ToString("D2"))</div>
            <div>Kills @completed.Kills / @completed.TotalKills · Items @completed.Items / @completed.TotalItems · Secrets @completed.Secrets / @completed.TotalSecrets</div>
            @if (completed.Kind == HereticExitKind.NextMap && _session.State.Health > 0)
            {
                <button style="padding: 12px; margin-top: 12px;" onclick="@ContinueCampaign">Continue to E@(completed.Episode)M@(completed.NextMap) — Enter</button>
            }
            else if (completed.Kind == HereticExitKind.UnsupportedRoute)
            {
                <div>No campaign route is defined for this map.</div>
            }
            @if (!string.IsNullOrEmpty(_transitionError))
            {
                <div style="color: #ffaaaa;">@_transitionError</div>
            }
        </div>
    }
    @if (_session != null && !_session.ExitRequested && _session.State.Health <= 0)
    {
        <div style="position: absolute; background-color: #111e; padding: 24px; color: white; flex-direction: column; align-items: center; pointer-events: all;">
            <div style="font-size: 28px;">You died</div>
            <button style="padding: 12px;" onclick="@RestartLevel">Restart level — Enter</button>
            @if (!string.IsNullOrEmpty(_transitionError))
            {
                <div style="color: #ffaaaa;">@_transitionError</div>
            }
        </div>
    }
    @if (!string.IsNullOrEmpty(_musicError)) { <div style="color: #ffaaaa;">@_musicError</div> }
    @if (_stepper.Paused)
    {
        <div style="position: absolute; background-color: #111e; padding: 24px; color: white; flex-direction: column; align-items: center; pointer-events: all;">
            <div style="font-size: 28px;">Paused</div>
            <button style="padding: 12px;" onclick="@TogglePause">Resume — Escape</button>
        </div>
    }
    <SboxManagedDoomLicenses />
</root>

@code {
    [Property] public string WadPath { get; set; } = "doom/blasphem.wad";
    [Property] public int Episode { get; set; } = 1;
    [Property] public int Map { get; set; } = 1;
    [Property] public GameSkill Skill { get; set; } = GameSkill.Medium;
    [Property] public bool Navigation { get; set; } = true;
    [Property] public bool MouseTurning { get; set; } = true;
    [Property] public int MouseSensitivity { get; set; } = 5;
    [Property] public bool TestCombat { get; set; }
    [Property] public bool MapMonsters { get; set; }
    [Property] public bool TestPoweredGauntlets { get; set; }
    [Property] public bool TestPoweredCrossbow { get; set; }
    [Property] public bool TestPoweredGoldWand { get; set; }
    [Property] public bool TestPoweredBlaster { get; set; }
    [Property] public bool TestPoweredPhoenix { get; set; }
    [Property] public bool TestPoweredSkullRod { get; set; }
    [Property] public bool TestPoweredMace { get; set; }
    [Property] public bool TestPlayerChicken { get; set; }
    [Property] public bool TestPoweredStaff { get; set; }
    [Property] public bool TestMace { get; set; }
    [Property] public bool TestPhoenix { get; set; }
    [Property] public bool TestSkullRod { get; set; }
    [Property] public bool TestCrossbow { get; set; }
    [Property] public bool TestGauntlets { get; set; }
    [Property] public bool TestBlaster { get; set; }
    [Property] public bool TestFlight { get; set; }
    private HereticWorldSession _session;
    private SboxHereticSound _sound;
    private SboxManagedDoomMusic _music;
    private string _musicError, _failedMusicTrack;
    [Property] public int MusicVolume { get; set; } = 8;
    [Property] public bool MusicEnabled { get; set; } = true;
    [Property] public float SoundVolume { get; set; } = 0.4f;
    private HereticFrameStepper _stepper = new();
    private string _transitionError;
    private bool _releaseActions;
    [Property] public float Yaw { get; set; }
    private GameContent _content;
    private HereticMapPreview _preview;
    private global::Sandbox.Texture _texture;
    private readonly byte[] _pixels = new byte[HereticMapPreview.Width * HereticMapPreview.Height * 4];
    private string _message = "Loading Heretic geometry preview...";
    private float _elapsed;
    private int _lastTic = -1;
    private float _lastYaw = float.NaN;

    protected override void OnStart()
    {
        try
        {
            _content = GameContent.CreateHereticPreview(WadPath);
            if (Navigation)
            {
                _session = new HereticWorldSession(_content, Episode, Map, Skill);
                if (TestCombat && MapMonsters) _session.StartMapCombat();
                if (TestCombat && !MapMonsters && _session.StartClinkTest() is null) throw new InvalidOperationException("No space for the Clink test encounter.");
                if (TestCombat && TestPoweredGauntlets) _session.GoldWand.GrantTestPoweredGauntlets();
                if (TestCombat && TestPoweredCrossbow) _session.GoldWand.GrantTestPoweredCrossbow();
                if (TestCombat && TestPoweredGoldWand) _session.GoldWand.GrantTestPoweredGoldWand();
                if (TestCombat && TestPoweredBlaster) _session.GoldWand.GrantTestPoweredBlaster();
                if (TestCombat && TestPoweredPhoenix) _session.GoldWand.GrantTestPoweredPhoenix();
                if (TestCombat && TestPoweredSkullRod) _session.GoldWand.GrantTestPoweredSkullRod();
                if (TestCombat && TestPoweredMace) _session.GoldWand.GrantTestPoweredMace();
                if (TestCombat && TestPoweredStaff) _session.GoldWand.GrantTestPoweredStaff();
                if (TestCombat && TestPlayerChicken) _session.MorphPlayer();
                if (TestCombat && TestMace) _session.GoldWand.GrantTestMace();
                if (TestCombat && TestPhoenix) _session.GoldWand.GrantTestPhoenix();
                if (TestCombat && TestSkullRod) _session.GoldWand.GrantTestSkullRod();
                if (TestCombat && TestCrossbow) _session.GoldWand.GrantTestCrossbow();
                if (TestCombat && TestGauntlets) _session.GoldWand.GrantTestGauntlets();
                if (TestCombat && TestBlaster) _session.GoldWand.GrantTestBlaster();
                if (TestCombat) _sound = new SboxHereticSound(_content, _session);
                _preview = new HereticMapPreview(_content, _session);
            }
            else _preview = new HereticMapPreview(_content, Episode, Map);
            _texture = global::Sandbox.Texture.Create(HereticMapPreview.Width, HereticMapPreview.Height, ImageFormat.RGBA8888)
                .WithDynamicUsage().Finish();
            _message = _preview.Report;
            try { _music = new SboxManagedDoomMusic(new Config(), _content); }
            catch (Exception ex) { _musicError = "Music unavailable: " + ex.Message; }
        }
        catch (Exception ex)
        {
            _sound?.Dispose(); _sound = null;
            _music?.StartMusic(Bgm.NONE, false); _music = null;
            _content?.Dispose();
            _content = null;
            _preview = null;
            _message = "Heretic preview: " + ex.Message;
        }
        StateHasChanged();
    }

    protected override void OnUpdate()
    {
        if (_preview is null) return;
        try
        {
            UpdateMusic();
            if (_session != null && !_session.ExitRequested && Input.Keyboard.Pressed("ESCAPE")) TogglePause();
            if (_stepper.Paused) { StateHasChanged(); return; }
            if (_sound != null) { _sound.Volume = SoundVolume; _sound.Update(); }
            if (_session != null && !_session.ExitRequested && _session.State.Health <= 0 && Input.Keyboard.Pressed("ENTER"))
            {
                RestartLevel();
                return;
            }
            if (_session?.ExitRequested == true)
            {
                if (Input.Keyboard.Pressed("ENTER")) ContinueCampaign();
                // Keep the completed frame, stats and pending inputs frozen during intermission.
                StateHasChanged();
                return;
            }
            if (_session != null)
            {
                if (TestCombat && Input.Keyboard.Pressed("V")) { _preview.InventoryVisible = !_preview.InventoryVisible; _lastTic = -1; }
                if (Input.Keyboard.Pressed("TAB")) { _preview.AutomapVisible = !_preview.AutomapVisible; _lastTic = -1; }
                if (_preview.AutomapVisible)
                {
                    if (Input.Keyboard.Pressed("O")) _preview.Automap.ToggleFollow();
                    if (Input.Keyboard.Pressed("M")) _preview.Automap.AddMark();
                    if (Input.Keyboard.Pressed("C")) _preview.Automap.ClearMarks();
                    _preview.Automap.Pan((Input.Keyboard.Down("RIGHT") ? 1 : 0) - (Input.Keyboard.Down("LEFT") ? 1 : 0),
                        (Input.Keyboard.Down("UP") ? 1 : 0) - (Input.Keyboard.Down("DOWN") ? 1 : 0), Time.Delta);
                    _lastTic = -1;
                }
                if (_preview.AutomapVisible && Input.Keyboard.Pressed("Z")) { _preview.ZoomAutomap(true); _lastTic = -1; }
                if (_preview.AutomapVisible && Input.Keyboard.Pressed("X")) { _preview.ZoomAutomap(false); _lastTic = -1; }
            }
            _elapsed += Time.Delta;
            var tic = (int)(_elapsed * 35);
            if (_session is not null)
            {
                var running = Input.Keyboard.Down("SHIFT") || Input.Keyboard.Down("LSHIFT");
                var command = new HereticCommand {
                    Forward = (sbyte)(((Input.Keyboard.Down("W") ? 1 : 0) - (Input.Keyboard.Down("S") ? 1 : 0)) * (running ? 50 : 25)),
                    Side = (sbyte)(((Input.Keyboard.Down("D") ? 1 : 0) - (Input.Keyboard.Down("A") ? 1 : 0)) * (running ? 40 : 24)),
                    Turn = _preview.AutomapVisible ? (short)0 : (short)((Input.Keyboard.Down("LEFT") ? 640 : 0) - (Input.Keyboard.Down("RIGHT") ? 640 : 0)),
                    Look = _preview.AutomapVisible ? (sbyte)0 : (sbyte)((Input.Keyboard.Down("UP") ? 1 : 0) - (Input.Keyboard.Down("DOWN") ? 1 : 0)),
                    Fly = (sbyte)((Input.Keyboard.Down("R") ? 1 : 0) - (Input.Keyboard.Down("F") ? 1 : 0)),
                    SelectWeapon = TestCombat && Input.Keyboard.Pressed("1") ? HereticWeapon.wp_staff : TestCombat && Input.Keyboard.Pressed("2") ? HereticWeapon.wp_goldwand : TestCombat && Input.Keyboard.Pressed("3") ? HereticWeapon.wp_crossbow : TestCombat && Input.Keyboard.Pressed("4") ? HereticWeapon.wp_blaster : TestCombat && Input.Keyboard.Pressed("5") ? HereticWeapon.wp_skullrod : TestCombat && Input.Keyboard.Pressed("6") ? HereticWeapon.wp_phoenixrod : TestCombat && Input.Keyboard.Pressed("7") ? HereticWeapon.wp_mace : TestCombat && Input.Keyboard.Pressed("8") ? HereticWeapon.wp_gauntlets : null,
                    UseArtifact = TestCombat && Input.Keyboard.Pressed("Q") ? HereticArtifact.QuartzFlask : TestCombat && Input.Keyboard.Pressed("U") ? HereticArtifact.MysticUrn : TestCombat && Input.Keyboard.Pressed("G") ? HereticArtifact.WingsOfWrath : TestCombat && Input.Keyboard.Pressed("I") ? HereticArtifact.RingOfInvincibility : TestCombat && Input.Keyboard.Pressed("T") ? HereticArtifact.Torch : TestCombat && Input.Keyboard.Pressed("H") ? HereticArtifact.ChaosDevice : TestCombat && Input.Keyboard.Pressed("B") ? HereticArtifact.TimeBomb : TestCombat && Input.Keyboard.Pressed("L") ? HereticArtifact.MorphOvum : TestCombat && Input.Keyboard.Pressed("K") ? HereticArtifact.TomeOfPower : TestCombat && Input.Keyboard.Pressed("J") ? HereticArtifact.Shadowsphere : null,
                    TestAttack = TestCombat && Input.Keyboard.Down("SPACE"),
                    Use = Input.Keyboard.Down("E"), CenterLook = Input.Keyboard.Down("HOME"), Land = Input.Keyboard.Down("END")
                };
                if (MouseTurning && !_preview.AutomapVisible && Input.Keyboard.Down("MOUSE2"))
                {
                    var mouseX = Input.MouseDelta.x;
                    if (float.IsFinite(mouseX)) _stepper.QueueFrameTurn(-Math.Clamp(mouseX, -256f, 256f) * Math.Clamp(MouseSensitivity, 1, 9) * 8);
                }
                else _stepper.ClearFrameTurn();
                _stepper.Advance(Time.Delta, command, StepNavigation);
                tic = _stepper.TickCount;
                _message = "Navigation test: Escape pauses; hold right mouse to turn; Tab automap; Z/X zoom; O follow/free pan; arrows pan; M mark; C clear; WASD move; Shift run; arrows turn/look; E use; Home center; R/F fly (Test Flight); End land. " +
                    "Health " + _session.State.Health + "; armor " + _session.State.ArmorPoints + "; keys " + _session.State.Keys + ". " + _session.State.Message +
                    " Actors: " + _session.Actors.Count + "; unsupported map things: " + _session.UnsupportedMapThings + "; unknown: " + _session.UnknownMapThings + ". " + (TestCombat ? "Combat preview: 1 selects staff (powered with Test Powered Staff), 2 Gold Wand (Test Powered Gold Wand enables powered shots), 3 Crossbow (Test Powered Crossbow enables powered shots), 4 Dragon Claw (pickup, Test Blaster or Test Powered Blaster); 5 Hellstaff (pickup, Test Skull Rod or Test Powered Skull Rod); 6 Phoenix Rod (pickup, Test Phoenix or Test Powered Phoenix); 7 Firemace (pickup, Test Mace or Test Powered Mace); 8 Gauntlets (pickup, Test Gauntlets or Test Powered Gauntlets); Space attacks; mace ammo " + _session.GoldWand?.MaceAmmo + "; Phoenix ammo " + _session.GoldWand?.PhoenixAmmo + "; Hellstaff ammo " + _session.GoldWand?.SkullRodAmmo + "; crossbow ammo " + _session.GoldWand?.CrossbowAmmo + "; claw ammo " + _session.GoldWand?.BlasterAmmo + "; wand ammo " + _session.GoldWand?.Ammo + "; Bag of Holding " + (_session.GoldWand?.HasBagOfHolding == true ? "yes" : "no") + "; kills " + _session.TestKills + ". Local encounter sounds enabled; Supported enemy ammo drops are collectible. Q uses Flask; U uses Urn; G uses Wings (R/F fly, End land); I uses Ring; T uses Torch; H uses Chaos Device; B places Time Bomb; J uses Shadowsphere; K uses Tome of Power; L uses Morph Ovum; V toggles artifact inventory. Morph Ovums " + _session.State.MorphOvums + ". Tomes " + _session.State.TomesOfPower + "; power seconds " + ((_session.State.WeaponPowerTics + 34) / 35) + ". Shadowspheres " + _session.State.Shadowspheres + "; ghost seconds " + ((_session.State.InvisibilityTics + 34) / 35) + ". Flasks " + _session.State.QuartzFlasks + "; urns " + _session.State.MysticUrns + "; wings " + _session.State.WingsOfWrath + "; bombs " + _session.State.TimeBombs + "; Chaos Devices " + _session.State.ChaosDevices + "; torches " + _session.State.Torches + "; torch seconds " + ((_session.State.TorchTics + 34) / 35) + "; rings " + _session.State.RingsOfInvincibility + "; invincibility seconds " + ((_session.State.InvulnerabilityTics + 34) / 35) + "; flight seconds " + ((_session.State.FlightTics + 34) / 35) + ". " : "Combat is disabled. ") + "Combat actors: " + _session.TestEnemyCount + "; blocked placements: " + _session.BlockedMapEnemies + ". Test Player Chicken enables timed player morphing. Campaign continuation is available at exits; saves and multiplayer are not active.";
                StateHasChanged();
            }
            if (tic == _lastTic && Yaw == _lastYaw) return;
            _preview.Render(_pixels, tic, Yaw);
            _texture.Update(_pixels, 0, 0, HereticMapPreview.Width, HereticMapPreview.Height);
            _lastTic = tic;
            _lastYaw = Yaw;
        }
        catch (Exception ex)
        {
            _sound?.Dispose(); _sound = null;
            _music?.StartMusic(Bgm.NONE, false); _music = null;
            _preview = null;
            _message = "Heretic preview: " + ex.Message;
            StateHasChanged();
        }
    }

    private void TogglePause()
    {
        if (_session == null || _session.ExitRequested || _session.World.Options.NetGame) return;
        _stepper.SetPaused(!_stepper.Paused);
        _releaseActions = true;
        // Stop already playing effects so combat sounds do not outlive the frozen world.
        if (_stepper.Paused) _sound?.StopEffects();
        StateHasChanged();
    }

    private void UpdateMusic()
    {
        if (_music == null) return;
        var track = MusicEnabled ? (_session == null ? HereticMusic.MapTrack(Episode, Map) : HereticMusic.TrackFor(_session)) : null;
        try
        {
            if (track != _failedMusicTrack || track == null) _music.StartLumpMusic(track, true);
            _music.Volume = MusicVolume;
            _music.Update();
        }
        catch (Exception ex)
        {
            _failedMusicTrack = track;
            _music.StartMusic(Bgm.NONE, false);
            _musicError = "Music unavailable: " + ex.Message;
        }
    }

    private void ContinueCampaign()
    {
        if (_session?.Completion?.Kind != HereticExitKind.NextMap || _session.State.Health <= 0) return;
        ReplaceSession(_session.CreateNextCampaignSession);
    }

    private void RestartLevel()
    {
        if (_stepper.Paused || _session == null || _session.ExitRequested || _session.State.Health > 0) return;
        ReplaceSession(_session.RestartAfterDeath);
    }

    private void ReplaceSession(Func<HereticWorldSession> createSession)
    {
        SboxHereticSound nextSound = null;
        try
        {
            var next = createSession();
            var nextPreview = new HereticMapPreview(_content, next);
            if (TestCombat) nextSound = new SboxHereticSound(_content, next) { Volume = SoundVolume };
            // Validate/render before swapping any live host objects.
            nextPreview.Render(_pixels, 0, Yaw);
            _texture.Update(_pixels, 0, 0, HereticMapPreview.Width, HereticMapPreview.Height);
            var oldSound = _sound;
            _session = next;
            _preview = nextPreview;
            _sound = nextSound;
            nextSound = null;
            _stepper = new HereticFrameStepper();
            _releaseActions = true;
            _elapsed = 0; _lastTic = -1; _lastYaw = float.NaN;
            _transitionError = null;
            _message = nextPreview.Report;
            _failedMusicTrack = null; _musicError = null;
            oldSound?.Dispose();
        }
        catch (Exception ex)
        {
            nextSound?.Dispose();
            _transitionError = "Unable to load level: " + ex.Message;
        }
        StateHasChanged();
    }

    private void StepNavigation(HereticCommand command)
    {
        if (_releaseActions)
        {
            if (!command.Use && !command.TestAttack) _releaseActions = false;
            command.Use = command.TestAttack = false;
            command.UseArtifact = null; command.SelectWeapon = null;
        }
        if (TestFlight) _session.GrantFlight(2);
        _session.Tick(command);
    }

    protected override void OnDestroy()
    {
        _preview = null;
        _sound?.Dispose(); _sound = null;
        _music?.StartMusic(Bgm.NONE, false); _music = null;
        _texture?.Dispose();
        _content?.Dispose();
        base.OnDestroy();
    }
}
