    private void DrawDoomPvpScoreboardOverlay( ManagedDoom.Doom doom, ManagedDoom.Video.DrawScreen screen )
    {
        if ( !ShouldShowPvpScoreboard() )
        {
            return;
        }

        var entries = GetPvpScoreboardEntries();
        if ( entries.Count == 0 )
        {
            return;
        }

        var scale = Math.Max( 1, screen.Width / 640 );
        var rowScale = scale;
        var margin = 4 * scale;
        var innerPadding = 3 * scale;
        var rowGap = scale;
        var subtitle = "GET 10 KILLS TO WIN";
        var subtitleHeight = 8 * rowScale;
        var rowHeight = 8 * rowScale;

        var nameWidth = 0;
        var killWidth = 0;
        foreach ( var entry in entries )
        {
            var displayName = GetDoomScoreboardDisplayName( entry.Name );
            nameWidth = Math.Max( nameWidth, screen.MeasureText( displayName, rowScale ) );
            killWidth = Math.Max( killWidth, screen.MeasureText( entry.Kills.ToString(), rowScale ) );
        }

        killWidth = Math.Max( killWidth, screen.MeasureText( "00", rowScale ) );

        var panelWidth = Math.Max(
            screen.MeasureText( subtitle, rowScale ),
            nameWidth + ( 4 * scale ) + killWidth ) + ( 2 * innerPadding );
        var panelHeight = ( 2 * innerPadding )
            + subtitleHeight
            + scale
            + ( entries.Count * rowHeight )
            + Math.Max( 0, entries.Count - 1 ) * rowGap;
        var panelX = Math.Max( margin, screen.Width - panelWidth - margin );
        var panelY = margin;

        screen.FillRect( panelX, panelY, panelWidth, panelHeight, 0 );

        var textX = panelX + innerPadding;
        var textY = panelY + innerPadding + ( 7 * rowScale );
        screen.DrawText( subtitle, textX, textY, rowScale );

        textY += subtitleHeight + scale;
        foreach ( var entry in entries )
        {
            var displayName = GetDoomScoreboardDisplayName( entry.Name );
            var killsText = entry.Kills.ToString();
            var killX = panelX + panelWidth - innerPadding - screen.MeasureText( killsText, rowScale );

            screen.DrawText( displayName, textX, textY, rowScale );
            screen.DrawText( killsText, killX, textY, rowScale );
            textY += rowHeight + rowGap;
        }

        DrawPvpWinnerOverlay( screen );
    }

    private void DrawPvpWinnerOverlay( ManagedDoom.Video.DrawScreen screen )
    {
        if ( string.IsNullOrWhiteSpace( _activePvpWinnerMessage )
            || DateTime.UtcNow >= _activePvpWinnerMessageUntilUtc )
        {
            return;
        }

        var scale = Math.Max( 2, screen.Width / 320 );
        var text = _activePvpWinnerMessage.ToUpperInvariant();
        var textWidth = screen.MeasureText( text, scale );
        var x = Math.Max( 0, ( screen.Width - textWidth ) / 2 );
        var y = Math.Max( 16 * scale, ( screen.Height / 2 ) - ( 4 * scale ) );
        screen.DrawText( text, x, y, scale );
    }

    private List<PvpScoreboardEntry> GetPvpScoreboardEntries()
    {
        var entries = new List<PvpScoreboardEntry>();
        if ( _doom?.Options?.Players is null )
        {
            return entries;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        var consolePlayer = _doom.Options.ConsolePlayer;
        var roster = BuildConnectedPlayerRoster();
        for ( var playerIndex = 0; playerIndex < ManagedDoom.Player.MaxPlayerCount && playerIndex < _doom.Options.Players.Length; playerIndex++ )
        {
            var player = _doom.Options.Players[playerIndex];
            if ( player?.InGame != true )
            {
                continue;
            }

            entries.Add( new PvpScoreboardEntry
            {
                Name = ResolvePvpScoreboardPlayerName( roster, playerIndex ),
                Kills = ResolvePvpScoreboardKills( session, player, playerIndex ),
                IsLocal = playerIndex == consolePlayer
            } );
        }

        entries.Sort( ComparePvpScoreboardEntries );
        return entries;
    }

    private string ResolvePvpScoreboardPlayerName( List<string> roster, int playerIndex )
    {
        if ( roster is not null && playerIndex >= 0 && playerIndex < roster.Count )
        {
            return roster[playerIndex];
        }

        return $"PLAYER {playerIndex + 1}";
    }

    private static string GetDoomScoreboardDisplayName( string name )
    {
        if ( string.IsNullOrWhiteSpace( name ) )
        {
            return "PLAYER";
        }

        return name.Trim().ToUpperInvariant();
    }

    private static int ResolvePvpScoreboardKills( SboxManagedDoomMultiplayerSessionComponent session, ManagedDoom.Player player, int playerIndex )
    {
        if ( player is null || playerIndex < 0 || playerIndex >= ManagedDoom.Player.MaxPlayerCount )
        {
            return 0;
        }

        var frags = ResolveAuthoritativePvpFrags( session, player, playerIndex );
        var kills = 0;
        for ( var fragIndex = 0; fragIndex < ManagedDoom.Player.MaxPlayerCount; fragIndex++ )
        {
            if ( fragIndex == playerIndex )
            {
                kills -= frags[fragIndex];
            }
            else
            {
                kills += frags[fragIndex];
            }
        }

        return kills;
    }

    private static int[] ResolveAuthoritativePvpFrags( SboxManagedDoomMultiplayerSessionComponent session, ManagedDoom.Player player, int playerIndex )
    {
        if ( session?.PvpActive != true )
        {
            return player.Frags;
        }

        return playerIndex == 0
            ? new[]
            {
                session.Player0StateFrag0,
                session.Player0StateFrag1,
                session.Player0StateFrag2,
                session.Player0StateFrag3
            }
            : new[]
            {
                session.Player1StateFrag0,
                session.Player1StateFrag1,
                session.Player1StateFrag2,
                session.Player1StateFrag3
            };
    }

    private static int ComparePvpScoreboardEntries( PvpScoreboardEntry left, PvpScoreboardEntry right )
    {
        var result = right.Kills.CompareTo( left.Kills );
        if ( result != 0 )
        {
            return result;
        }

        return string.Compare( left.Name, right.Name, StringComparison.OrdinalIgnoreCase );
    }

    private void StartHostedMatch()
    {
