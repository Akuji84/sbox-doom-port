            _attackDown = player.AttackDown;
            _useDown = player.UseDown;
            _refire = player.Refire;

            for ( var i = 0; i < player.PlayerSprites.Length; i++ )
            {
                var sprite = player.PlayerSprites[i];
                _playerSpriteStateNumbers[i] = sprite.State?.Number ?? -1;
                _playerSpriteTics[i] = sprite.Tics;
                _playerSpriteSx[i] = sprite.Sx.Data;
                _playerSpriteSy[i] = sprite.Sy.Data;
            }
        }

        public void Restore( ManagedDoom.Player player )
        {
            if ( !_captured || player is null )
            {
                return;
            }

            player.ViewZ = _viewZ;
            player.ViewHeight = _viewHeight;
            player.DeltaViewHeight = _deltaViewHeight;
            player.Bob = _bob;
            if ( player.Mobj is not null )
            {
                player.Mobj.Angle = _mobjAngle;
            }
            player.ReadyWeapon = _readyWeapon;
            player.PendingWeapon = _pendingWeapon;
            player.AttackDown = _attackDown;
            player.UseDown = _useDown;
            player.Refire = _refire;

            for ( var i = 0; i < player.PlayerSprites.Length; i++ )
            {
                var sprite = player.PlayerSprites[i];
                var stateNumber = _playerSpriteStateNumbers[i];
                sprite.State = stateNumber >= 0 ? ManagedDoom.DoomInfo.States[stateNumber] : null;
                sprite.Tics = _playerSpriteTics[i];
                sprite.Sx = new ManagedDoom.Fixed( _playerSpriteSx[i] );
                sprite.Sy = new ManagedDoom.Fixed( _playerSpriteSy[i] );
            }
        }
    }

}
