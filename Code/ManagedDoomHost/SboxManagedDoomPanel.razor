    private void EnsurePvpPickupTrackingInitialized()
    {
        if ( _doom?.Game?.World is null )
        {
            return;
        }

        if ( _pvpMapThingIndexes.Count == 0 )
        {
            var things = _doom.Game.World.Map.Things;
            for ( var i = 0; i < things.Length; i++ )
            {
                var thing = things[i];
                if ( thing is not null && !_pvpMapThingIndexes.ContainsKey( thing ) )
                {
                    _pvpMapThingIndexes.Add( thing, i );
                }
            }
        }

        if ( _initialPvpPickupThingIndexes.Count == 0 )
        {
            foreach ( var thinker in _doom.Game.World.Thinkers )
            {
                if ( thinker is ManagedDoom.Mobj mobj
                    && mobj.SpawnPoint is not null
                    && ( mobj.Flags & ManagedDoom.MobjFlags.Special ) != 0
                    && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var mapThingIndex ) )
                {
                    _initialPvpPickupThingIndexes.Add( mapThingIndex );
                }
            }
        }

        if ( _initialPvpDestroyableThingIndexes.Count == 0 )
        {
            foreach ( var thinker in _doom.Game.World.Thinkers )
            {
                if ( thinker is ManagedDoom.Mobj mobj
                    && mobj.SpawnPoint is not null
                    && mobj.Type == ManagedDoom.MobjType.Barrel
                    && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var mapThingIndex ) )
                {
                    _initialPvpDestroyableThingIndexes.Add( mapThingIndex );
                }
            }
        }
    }

    private void PumpAuthoritativePvpPickupState()
    {
        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session is null || _doom?.Game?.World is null || !_multiplayerModeController.PvpMatchLoaded )
        {
            return;
        }

        EnsurePvpPickupTrackingInitialized();
        if ( _initialPvpPickupThingIndexes.Count == 0 )
        {
            return;
        }

        if ( Networking.IsHost )
        {
            var activePickupThingIndexes = new HashSet<int>();
            foreach ( var thinker in _doom.Game.World.Thinkers )
            {
                if ( thinker is ManagedDoom.Mobj mobj
                    && mobj.SpawnPoint is not null
                    && ( mobj.Flags & ManagedDoom.MobjFlags.Special ) != 0
                    && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var mapThingIndex ) )
                {
                    activePickupThingIndexes.Add( mapThingIndex );
                }
            }

            var removedIndexes = new List<int>();
            foreach ( var initialIndex in _initialPvpPickupThingIndexes )
            {
                if ( !activePickupThingIndexes.Contains( initialIndex ) )
                {
                    removedIndexes.Add( initialIndex );
                }
            }

            removedIndexes.Sort();
            var removedIndexesValue = removedIndexes.Count == 0
                ? string.Empty
                : string.Join( ",", removedIndexes );

            if ( !string.Equals( session.RemovedPickupThingIndexes, removedIndexesValue, StringComparison.Ordinal ) )
            {
                session.RemovedPickupThingIndexes = removedIndexesValue;
            }

            _lastPublishedRemovedPickupThingIndexes = removedIndexesValue;
            return;
        }

        var removedPickupThingIndexes = session.RemovedPickupThingIndexes ?? string.Empty;
        if ( string.Equals( _lastAppliedRemovedPickupThingIndexes, removedPickupThingIndexes, StringComparison.Ordinal ) )
        {
            return;
        }

        var removedIndexSet = ParseThingIndexSet( removedPickupThingIndexes );
        foreach ( var removedIndex in removedIndexSet )
        {
            _predictedPickupThingTimes.Remove( removedIndex );
        }

        var toRemove = new List<ManagedDoom.Mobj>();
        foreach ( var thinker in _doom.Game.World.Thinkers )
        {
            if ( thinker is ManagedDoom.Mobj mobj
                && mobj.SpawnPoint is not null
                && ( mobj.Flags & ManagedDoom.MobjFlags.Special ) != 0
                && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var mapThingIndex )
                && removedIndexSet.Contains( mapThingIndex ) )
            {
                toRemove.Add( mobj );
            }
        }

        for ( var i = 0; i < toRemove.Count; i++ )
        {
            _doom.Game.World.ThingAllocation.RemoveMobj( toRemove[i] );
        }

        _lastAppliedRemovedPickupThingIndexes = removedPickupThingIndexes;
    }

    private void PumpAuthoritativePvpDestroyedWorldThingState()
    {
        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session is null || _doom?.Game?.World is null || !_multiplayerModeController.PvpMatchLoaded )
        {
            return;
        }

        EnsurePvpPickupTrackingInitialized();
        if ( _initialPvpDestroyableThingIndexes.Count == 0 )
        {
            return;
        }

        if ( Networking.IsHost )
        {
            var activeDestroyableThingIndexes = new HashSet<int>();
            foreach ( var thinker in _doom.Game.World.Thinkers )
            {
                if ( thinker is ManagedDoom.Mobj mobj
                    && mobj.SpawnPoint is not null
                    && mobj.Type == ManagedDoom.MobjType.Barrel
                    && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var mapThingIndex ) )
                {
                    activeDestroyableThingIndexes.Add( mapThingIndex );
                }
            }

            var destroyedIndexes = new List<int>();
            foreach ( var initialIndex in _initialPvpDestroyableThingIndexes )
            {
                if ( !activeDestroyableThingIndexes.Contains( initialIndex ) )
                {
                    destroyedIndexes.Add( initialIndex );
                }
            }

            destroyedIndexes.Sort();
            var destroyedIndexesValue = destroyedIndexes.Count == 0
                ? string.Empty
                : string.Join( ",", destroyedIndexes );

            var previouslyDestroyedIndexes = ParseThingIndexSet( _lastPublishedDestroyedWorldThingIndexes );
            for ( var i = 0; i < destroyedIndexes.Count; i++ )
            {
                var destroyedIndex = destroyedIndexes[i];
                if ( !previouslyDestroyedIndexes.Contains( destroyedIndex ) )
                {
                    session.QueueEffectEvent(
                        SboxManagedDoomMultiplayerSessionComponent.MultiplayerEffectEventType.BarrelExploded,
                        destroyedIndex,
                        0 );
                }
            }

            if ( !string.Equals( session.DestroyedWorldThingIndexes, destroyedIndexesValue, StringComparison.Ordinal ) )
            {
                session.DestroyedWorldThingIndexes = destroyedIndexesValue;
            }

            _lastPublishedDestroyedWorldThingIndexes = destroyedIndexesValue;
            return;
        }

        var destroyedWorldThingIndexes = session.DestroyedWorldThingIndexes ?? string.Empty;
        if ( string.Equals( _lastAppliedDestroyedWorldThingIndexes, destroyedWorldThingIndexes, StringComparison.Ordinal ) )
        {
            return;
        }

        var destroyedIndexSet = ParseThingIndexSet( destroyedWorldThingIndexes );

        var toRemove = new List<ManagedDoom.Mobj>();
        foreach ( var thinker in _doom.Game.World.Thinkers )
        {
            if ( thinker is ManagedDoom.Mobj mobj
                && mobj.SpawnPoint is not null
                && mobj.Type == ManagedDoom.MobjType.Barrel
                && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var mapThingIndex )
                && destroyedIndexSet.Contains( mapThingIndex ) )
            {
                toRemove.Add( mobj );
            }
        }

        for ( var i = 0; i < toRemove.Count; i++ )
        {
            PlayReplicatedBarrelExplosion( toRemove[i] );
        }

        _lastAppliedDestroyedWorldThingIndexes = destroyedWorldThingIndexes;
    }

    private void PumpAuthoritativePvpWorldState()
    {
        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session is null || _doom?.Game?.World is null || !_multiplayerModeController.PvpMatchLoaded )
        {
            return;
        }

        var world = _doom.Game.World;

        if ( Networking.IsHost )
        {
            var sectorParts = new List<string>( world.Map.Sectors.Length );
            foreach ( var sector in world.Map.Sectors )
            {
                sectorParts.Add( $"{sector.Number}:{sector.FloorHeight.Data}:{sector.CeilingHeight.Data}" );
            }

            var sectorState = string.Join( ";", sectorParts );
            if ( !string.Equals( session.PvpSectorState, sectorState, StringComparison.Ordinal ) )
            {
                session.PvpSectorState = sectorState;
            }

            _lastPublishedPvpSectorState = sectorState;

            var lineParts = new List<string>( world.Map.Lines.Length );
            var lines = world.Map.Lines;
            for ( var i = 0; i < lines.Length; i++ )
            {
                var line = lines[i];
                var front = line.FrontSide;
                if ( front is null )
                {
                    continue;
                }

                lineParts.Add( $"{i}:{(int)line.Special}:{front.TopTexture}:{front.MiddleTexture}:{front.BottomTexture}" );
            }

            var lineState = string.Join( ";", lineParts );
            if ( !string.Equals( session.PvpLineState, lineState, StringComparison.Ordinal ) )
            {
                session.PvpLineState = lineState;
            }

            _lastPublishedPvpLineState = lineState;
            return;
        }

        var sectorStateToApply = session.PvpSectorState ?? string.Empty;
        if ( !string.Equals( _lastAppliedPvpSectorState, sectorStateToApply, StringComparison.Ordinal ) )
        {
            ApplyAuthoritativePvpSectorState( world, sectorStateToApply );
            _lastAppliedPvpSectorState = sectorStateToApply;
        }

        var lineStateToApply = session.PvpLineState ?? string.Empty;
        if ( !string.Equals( _lastAppliedPvpLineState, lineStateToApply, StringComparison.Ordinal ) )
        {
            ApplyAuthoritativePvpLineState( world, lineStateToApply );
            _lastAppliedPvpLineState = lineStateToApply;
        }
    }

    private static void ApplyAuthoritativePvpSectorState( ManagedDoom.World world, string sectorState )
    {
        if ( string.IsNullOrWhiteSpace( sectorState ) )
        {
            return;
        }

        var sectors = world.Map.Sectors;
        var entries = sectorState.Split( ';', StringSplitOptions.RemoveEmptyEntries );
        for ( var i = 0; i < entries.Length; i++ )
        {
            var parts = entries[i].Split( ':', StringSplitOptions.RemoveEmptyEntries );
            if ( parts.Length != 3
                || !int.TryParse( parts[0], out var sectorIndex )
                || !int.TryParse( parts[1], out var floorHeight )
                || !int.TryParse( parts[2], out var ceilingHeight )
                || sectorIndex < 0
                || sectorIndex >= sectors.Length )
            {
                continue;
            }

            var sector = sectors[sectorIndex];
            sector.FloorHeight = new ManagedDoom.Fixed( floorHeight );
            sector.CeilingHeight = new ManagedDoom.Fixed( ceilingHeight );
            sector.DisableFrameInterpolationForOneFrame();
        }
    }

    private static void ApplyAuthoritativePvpLineState( ManagedDoom.World world, string lineState )
    {
        if ( string.IsNullOrWhiteSpace( lineState ) )
        {
            return;
        }

        var lines = world.Map.Lines;
        var entries = lineState.Split( ';', StringSplitOptions.RemoveEmptyEntries );
        for ( var i = 0; i < entries.Length; i++ )
        {
            var parts = entries[i].Split( ':', StringSplitOptions.RemoveEmptyEntries );
            if ( parts.Length != 5
                || !int.TryParse( parts[0], out var lineIndex )
                || !int.TryParse( parts[1], out var special )
                || !int.TryParse( parts[2], out var topTexture )
                || !int.TryParse( parts[3], out var middleTexture )
                || !int.TryParse( parts[4], out var bottomTexture )
                || lineIndex < 0
                || lineIndex >= lines.Length )
            {
                continue;
            }

            var line = lines[lineIndex];
            line.Special = (ManagedDoom.LineSpecial)special;

            var front = line.FrontSide;
            if ( front is null )
            {
                continue;
            }

            front.TopTexture = topTexture;
            front.MiddleTexture = middleTexture;
            front.BottomTexture = bottomTexture;
        }
    }

    private void BuildMultiplayerPvpCommands( ManagedDoom.TicCmd[] cmds, ManagedDoom.GameOptions options )
    {
        if ( _input is null )
        {
            return;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        var localPlayerIndex = Networking.IsHost ? 0 : 1;
        var remotePlayerIndex = localPlayerIndex == 0 ? 1 : 0;

        if ( UseSharedSimulationPvp( session ) )
        {
            if ( _activeSharedSimulationPvpCommandTic < 0 )
            {
                cmds[localPlayerIndex].Clear();
                cmds[remotePlayerIndex].Clear();
                return;
            }

            if ( !_sharedSimulationLocalPvpCommands.TryGetValue( _activeSharedSimulationPvpCommandTic, out var localCommand ) )
            {
                localCommand = BuildCurrentSharedSimulationPvpCommand();
                _sharedSimulationLocalPvpCommands[_activeSharedSimulationPvpCommandTic] = localCommand;
            }

            ApplySharedSimulationTicCommand( localCommand, cmds[localPlayerIndex] );

            if ( !session.TryCopyQueuedPlayerCommandTo( remotePlayerIndex, _activeSharedSimulationPvpCommandTic, cmds[remotePlayerIndex] ) )
            {
                cmds[remotePlayerIndex].Clear();
            }

            return;
        }

        _input.BuildTicCmd( cmds[localPlayerIndex] );

        session?.SetPlayerCommandRpc(
            localPlayerIndex,
            cmds[localPlayerIndex].ForwardMove,
            cmds[localPlayerIndex].SideMove,
            cmds[localPlayerIndex].AngleTurn,
            cmds[localPlayerIndex].Buttons );

        session?.CopyPlayerCommandTo( remotePlayerIndex, cmds[remotePlayerIndex] );
    }

    private void QueueSharedSimulationPvpLocalCommands( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( session is null || _input is null )
        {
            return;
        }

        var localPlayerIndex = Networking.IsHost ? 0 : 1;
        var queueUpToTic = _nextSharedSimulationPvpTic + SharedSimulationPvpCommandLeadTics;

        while ( _lastQueuedSharedSimulationLocalPvpTic < queueUpToTic )
        {
            var tic = _lastQueuedSharedSimulationLocalPvpTic + 1;
            var cmd = BuildCurrentSharedSimulationPvpCommand();
            _sharedSimulationLocalPvpCommands[tic] = cmd;
            session.QueuePlayerCommandRpc( localPlayerIndex, tic, cmd.ForwardMove, cmd.SideMove, cmd.AngleTurn, cmd.Buttons );
            _lastQueuedSharedSimulationLocalPvpTic = tic;
        }
    }

    private bool CanAdvanceSharedSimulationPvpTic( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( session is null )
        {
            return false;
        }

        var localPlayerIndex = Networking.IsHost ? 0 : 1;
        var remotePlayerIndex = localPlayerIndex == 0 ? 1 : 0;

        if ( !_sharedSimulationLocalPvpCommands.ContainsKey( _nextSharedSimulationPvpTic ) )
        {
            return false;
        }

        return session.TryCopyQueuedPlayerCommandTo( remotePlayerIndex, _nextSharedSimulationPvpTic, _replicaLocalPvpCommand );
    }

    private SharedSimulationTicCommand BuildCurrentSharedSimulationPvpCommand()
    {
        var cmd = new ManagedDoom.TicCmd();
        _input.BuildTicCmd( cmd );
        return new SharedSimulationTicCommand
        {
            ForwardMove = cmd.ForwardMove,
            SideMove = cmd.SideMove,
            AngleTurn = cmd.AngleTurn,
            Buttons = cmd.Buttons
        };
    }

    private static void ApplySharedSimulationTicCommand( SharedSimulationTicCommand source, ManagedDoom.TicCmd destination )
    {
        if ( destination is null )
        {
            return;
        }

        destination.ForwardMove = source.ForwardMove;
        destination.SideMove = source.SideMove;
        destination.AngleTurn = source.AngleTurn;
        destination.Buttons = source.Buttons;
    }

    private void CleanupSharedSimulationPvpLocalCommands()
    {
        if ( _sharedSimulationLocalPvpCommands.Count == 0 )
        {
            return;
        }

        var minTicToKeep = Math.Max( 0, _nextSharedSimulationPvpTic - 4 );
        var staleTics = new List<int>();
        foreach ( var tic in _sharedSimulationLocalPvpCommands.Keys )
        {
            if ( tic < minTicToKeep )
            {
                staleTics.Add( tic );
            }
        }

        foreach ( var tic in staleTics )
        {
            _sharedSimulationLocalPvpCommands.Remove( tic );
        }
    }

    private bool EnsureSharedSimulationPvpStartBarrier( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( session is null )
        {
            return false;
        }

        var localPlayerIndex = Networking.IsHost ? 0 : 1;
        if ( !_sharedSimulationPvpReadyReported )
        {
            session.SetPvpReadyRpc( localPlayerIndex, true );
            _sharedSimulationPvpReadyReported = true;
        }

        if ( Networking.IsHost
            && session.Player0PvpReady
            && session.Player1PvpReady
            && !session.SharedSimulationPvpStarted )
        {
            session.BeginSharedSimulationPvpRpc();
        }

        if ( session.SharedSimulationPvpStartSerial > _lastHandledSharedSimulationPvpStartSerial )
        {
            _lastHandledSharedSimulationPvpStartSerial = session.SharedSimulationPvpStartSerial;
            _sharedSimulationLocalPvpCommands.Clear();
            Array.Clear( _lastObservedSharedSimulationPlayerMobjs, 0, _lastObservedSharedSimulationPlayerMobjs.Length );
            Array.Clear( _lastObservedSharedSimulationPlayerStates, 0, _lastObservedSharedSimulationPlayerStates.Length );
            _nextSharedSimulationPvpTic = 0;
            _lastQueuedSharedSimulationLocalPvpTic = -1;
            _activeSharedSimulationPvpCommandTic = -1;
            _lastReportedPvpChecksumMismatchSignature = string.Empty;
            _lastLoggedSharedSimulationMismatchLevelTime = -1;
        }

        return session.SharedSimulationPvpStarted
            && _lastHandledSharedSimulationPvpStartSerial == session.SharedSimulationPvpStartSerial;
    }

    private void TrackSharedSimulationPvpPlayerRespawns()
    {
        if ( _doom?.Options?.Players is null )
        {
            return;
        }

        for ( var playerIndex = 0; playerIndex < 2 && playerIndex < _doom.Options.Players.Length; playerIndex++ )
        {
            var player = _doom.Options.Players[playerIndex];
            var currentMobj = player?.Mobj;
            var currentState = player?.PlayerState ?? ManagedDoom.PlayerState.Live;
            var previousMobj = _lastObservedSharedSimulationPlayerMobjs[playerIndex];

            if ( currentMobj is not null && currentMobj != previousMobj )
            {
                HandleSharedSimulationPvpPlayerBodySwap( playerIndex, player, currentMobj, previousMobj );
            }

            _lastObservedSharedSimulationPlayerMobjs[playerIndex] = currentMobj;
            _lastObservedSharedSimulationPlayerStates[playerIndex] = currentState;
        }
    }

    private void HandleSharedSimulationPvpPlayerBodySwap(
        int playerIndex,
        ManagedDoom.Player player,
        ManagedDoom.Mobj currentMobj,
        ManagedDoom.Mobj previousMobj )
    {
        if ( player is null || currentMobj is null || _doom?.Game?.World?.ThingMovement is null )
        {
            return;
        }

        Log.Info(
            $"[MP-PVP] Player body swap slot={playerIndex} host={Networking.IsHost} "
            + $"old={( previousMobj is null ? "null" : previousMobj.GetHashCode().ToString() )} "
            + $"new={currentMobj.GetHashCode()} "
            + $"state={player.PlayerState} "
            + $"pos={currentMobj.X.Data},{currentMobj.Y.Data},{currentMobj.Z.Data}" );

        RefreshSharedSimulationPvpPlayerBodyPresentation( player, currentMobj, previousMobj, _doom.Game.World.ThingMovement );
        _weaponRespawnSettleTics[playerIndex] = Math.Max( _weaponRespawnSettleTics[playerIndex], 8 );
    }

    private static void RefreshSharedSimulationPvpPlayerBodyPresentation(
        ManagedDoom.Player player,
        ManagedDoom.Mobj currentMobj,
        ManagedDoom.Mobj previousMobj,
        ManagedDoom.ThingMovement thingMovement )
    {
        if ( previousMobj is not null )
        {
            previousMobj.DisableFrameInterpolationForOneFrame();
        }

        if ( currentMobj.Subsector is null )
        {
            thingMovement.SetThingPosition( currentMobj );
        }
        else
        {
            thingMovement.UnsetThingPosition( currentMobj );
            thingMovement.SetThingPosition( currentMobj );
        }

        if ( currentMobj.Subsector is not null )
        {
            currentMobj.FloorZ = currentMobj.Subsector.Sector.FloorHeight;
            currentMobj.CeilingZ = currentMobj.Subsector.Sector.CeilingHeight;
        }

        currentMobj.DisableFrameInterpolationForOneFrame();
        player.DisableFrameInterpolationForOneFrame();
    }

