    private async Task StartHostingAsync()
    {
        Log.Info( "[MP-UI] StartHostingAsync clicked" );

        try
        {
            var hostName = GetLeaderboardDisplayName();
            await BootstrapHostedMultiplayerSessionAsync( hostName );
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Failed to create multiplayer lobby: {ex}" );
            SboxManagedDoomMultiplayerPanelService.SetHostStatus( "FAILED TO CREATE LOBBY." );
            StateHasChanged();
        }
    }

    private async System.Threading.Tasks.Task BootstrapHostedMultiplayerSessionAsync( string hostName )
    {
        EnsureMultiplayerLobbyListener();
        SboxManagedDoomMultiplayerPanelService.BeginHosting( hostName );
        StateHasChanged();

        await EnsureHostedLobbyTransportAsync( hostName );
        EnsureMultiplayerSessionBootstrap( hostName );
        _multiplayerSession?.MarkPlayerActiveRpc( hostName );
        PublishHostedLobbyDiscoveryState();
        _analytics?.OnHostedLobbyStarted( _multiplayerSession?.LobbyName ?? $"{hostName}'s server" );

        SboxManagedDoomMultiplayerPanelService.SetHostStatus( "LOBBY ACTIVE. WAITING FOR PLAYERS TO JOIN." );
        UpdateMultiplayerRostersFromConnections();
        StateHasChanged();
    }

    private static async System.Threading.Tasks.Task EnsureHostedLobbyTransportAsync( string hostName )
    {
        if ( Networking.IsActive )
        {
            return;
        }

        await System.Threading.Tasks.Task.Delay( 100 );
        Networking.CreateLobby( new Sandbox.Network.LobbyConfig
        {
            Name = $"{hostName}'s server",
            Privacy = Sandbox.Network.LobbyPrivacy.Public,
            MaxPlayers = 2
        } );
    }

    private void EnsureMultiplayerLobbyListener()
    {
        if ( _multiplayerLobbyListener is not null )
        {
            return;
        }

        _multiplayerLobbyListener = GameObject.AddComponent<SboxManagedDoomMultiplayerLobbyListener>();
    }

    private void EnsureMultiplayerSessionBootstrap( string hostName )
    {
        if ( _multiplayerSession is not null )
        {
            _multiplayerSession.LobbyName = $"{hostName}'s server";
            return;
        }

        var sessionObject = new global::Sandbox.GameObject();
        sessionObject.NetworkMode = global::Sandbox.NetworkMode.Object;
        _multiplayerSessionObject = sessionObject;
        _multiplayerSession = sessionObject.AddComponent<SboxManagedDoomMultiplayerSessionComponent>();
        _multiplayerSession.LobbyName = $"{hostName}'s server";
        sessionObject.NetworkSpawn();
    }

    private void DestroyMultiplayerSessionObject()
    {
        try
        {
            _multiplayerSessionObject?.Destroy();
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Failed to destroy multiplayer session object: {ex}" );
        }

        _multiplayerSessionObject = null;
        _multiplayerSession = null;
    }

    private void PublishHostedLobbyDiscoveryState()
    {
        if ( !Networking.IsHost )
        {
            return;
        }

        try
        {
            var lobbyName = _multiplayerSession?.LobbyName;
            Networking.SetData( LobbyDataStartedKey, _multiplayerSession?.PvpActive == true ? "1" : "0" );
            Networking.SetData(
                LobbyDataNameKey,
                string.IsNullOrWhiteSpace( lobbyName ) ? "DOOM PORT" : lobbyName.Trim() );
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Failed to publish lobby discovery state: {ex}" );
        }
    }

    private void RefreshMultiplayerSessionView()
    {
        Log.Info( "[MP-UI] RefreshMultiplayerSessionView clicked" );

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( Networking.IsActive && session is not null )
        {
            var roster = BuildConnectedPlayerRoster();
            if ( roster.Count == 0 )
            {
                roster.Add( GetLeaderboardDisplayName() );
            }

            if ( session.MatchStarted )
            {
                SboxManagedDoomMultiplayerPanelService.ShowMatchMenu( session.PvpActive
                    ? $"MATCH ACTIVE ON {session.LobbyName.ToUpperInvariant()}"
                    : $"CONNECTED TO {session.LobbyName.ToUpperInvariant()}" );
                StateHasChanged();
                return;
            }

            if ( Networking.IsHost )
            {
                SboxManagedDoomMultiplayerPanelService.SetHostedPlayers( roster );
                SboxManagedDoomMultiplayerPanelService.SetHostStatus( roster.Count > 1
                    ? "PLAYERS CONNECTED. START WHEN READY."
                    : "SESSION ACTIVE. WAITING FOR PLAYERS." );
                SboxManagedDoomMultiplayerPanelService.Show( SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.HostInfo );
            }
            else
            {
                session.MarkPlayerActiveRpc( GetLeaderboardDisplayName() );
                SboxManagedDoomMultiplayerPanelService.ShowJoinedLobby( session.LobbyName, roster );
            }

            StateHasChanged();
            return;
        }

        SboxManagedDoomMultiplayerPanelService.Show( SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.JoinInfo );
        SboxManagedDoomMultiplayerPanelService.SetJoinStatus( "USE S&BOX TO JOIN OR CREATE A MULTIPLAYER SESSION." );
        StateHasChanged();
    }

    private void ReportMultiplayerAnalytics( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( _analytics is null )
        {
            return;
        }

        if ( !Networking.IsActive || session is null )
        {
            _lastReportedJoinedLobbyAnalyticsKey = string.Empty;
            return;
        }

        if ( Networking.IsHost )
        {
            return;
        }

        var lobbyName = string.IsNullOrWhiteSpace( session.LobbyName ) ? "CONNECTED GAME" : session.LobbyName.Trim();
        if ( string.Equals( _lastReportedJoinedLobbyAnalyticsKey, lobbyName, StringComparison.Ordinal ) )
        {
            return;
        }

        _lastReportedJoinedLobbyAnalyticsKey = lobbyName;
        _analytics.OnJoinedHostedLobby( lobbyName, session.LobbyName );
    }

    private void UpdateMultiplayerRostersFromConnections()
    {
        if ( !SboxManagedDoomMultiplayerPanelService.IsOpen || !Networking.IsActive )
        {
            return;
        }

        var roster = BuildConnectedPlayerRoster();
        if ( roster.Count == 0 )
        {
            return;
        }

        if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.JoinLobby )
        {
            SboxManagedDoomMultiplayerPanelService.SetJoinedPlayers( roster );
        }
        else if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.MatchMenu )
        {
            if ( roster.Count <= 1 )
            {
                if ( Networking.IsHost )
                {
                    SboxManagedDoomMultiplayerPanelService.SetHostStatus( "LOBBY ACTIVE. WAITING FOR PLAYERS TO JOIN." );
                    SboxManagedDoomMultiplayerPanelService.SetHostedPlayers( roster );
                    SboxManagedDoomMultiplayerPanelService.Show( SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.HostInfo );
                }
                else
                {
                    SboxManagedDoomMultiplayerPanelService.Show( SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.Main );
                }
            }
        }
    }

    private List<string> BuildConnectedPlayerRoster()
    {
        var roster = new List<string>();
        var localName = GetLeaderboardDisplayName();
        if ( _multiplayerSession?.IsPlayerInactive( localName ) != true )
        {
            AddUniquePlayerName( roster, localName );
        }

        foreach ( var connection in Sandbox.Connection.All )
        {
            if ( _multiplayerSession?.IsPlayerInactive( connection.DisplayName ) == true )
            {
                continue;
            }

            AddUniquePlayerName( roster, connection.DisplayName );
        }

        return roster;
    }

    private static void AddUniquePlayerName( List<string> roster, string playerName )
    {
        if ( string.IsNullOrWhiteSpace( playerName ) )
        {
            return;
        }

        var trimmed = playerName.Trim();
        if ( !roster.Contains( trimmed ) )
        {
            roster.Add( trimmed );
        }
    }

