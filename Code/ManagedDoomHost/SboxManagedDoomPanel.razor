    private void ReturnMultiplayerGroupToLobby()
    {
        _ignoreStartedMultiplayerMatch = true;

        if ( _multiplayerSession is not null )
        {
            _multiplayerSession.StopPvpRpc();
            _multiplayerSession.CloseMatchMenuRpc();
            _multiplayerSession.MatchStarted = false;
        }
        PublishHostedLobbyDiscoveryState();

        ResetMultiplayerGameplayOverrides();

        if ( Networking.IsHost )
        {
            SboxManagedDoomMultiplayerPanelService.SetHostStatus( "LOBBY ACTIVE. WAITING FOR PLAYERS TO JOIN." );
            UpdateMultiplayerRostersFromConnections();
            SboxManagedDoomMultiplayerPanelService.Show( SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.HostInfo );
        }
        else
        {
            SboxManagedDoomMultiplayerPanelService.ShowJoinedLobby( "CONNECTED GAME", BuildConnectedPlayerRoster() );
        }

        StateHasChanged();
    }

    private void LeaveMultiplayerMatch()
    {
        _ignoreStartedMultiplayerMatch = true;

        _multiplayerSession?.StopPvpRpc();
        PublishHostedLobbyDiscoveryState();
        ResetMultiplayerGameplayOverrides();

        if ( Networking.IsHost )
        {
            _multiplayerSession?.CloseMatchMenuRpc();
            if ( _multiplayerSession is not null )
            {
                _multiplayerSession.MatchStarted = false;
                _multiplayerSession.MarkPlayerActiveRpc( GetLeaderboardDisplayName() );
            }
            PublishHostedLobbyDiscoveryState();
            SboxManagedDoomMultiplayerPanelService.SetHostStatus( "LOBBY ACTIVE. WAITING FOR PLAYERS TO JOIN." );
            UpdateMultiplayerRostersFromConnections();
            SboxManagedDoomMultiplayerPanelService.Show( SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.HostInfo );
        }
        else
        {
            if ( _multiplayerSession is not null )
            {
                _multiplayerSession.MarkPlayerInactiveRpc( GetLeaderboardDisplayName() );
            }

            SboxManagedDoomMultiplayerPanelService.ShowJoinedLobby( "CONNECTED GAME", BuildConnectedPlayerRoster() );
        }
        StateHasChanged();
    }

    private void TryEnterMultiplayerPvpMatch()
    {
        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( !_multiplayerModeController.TryCreatePvpLaunchPlan( _doom, _input, session, Networking.IsHost, out var launchPlan ) )
        {
            return;
        }

        Log.Info( $"[MP-PVP] Entering multiplayer PVP launch for map {launchPlan.MapName} as host={Networking.IsHost}, currentState={_doom.State}, currentGameState={_doom.Game?.State}" );

        var options = _doom.Options;
        _multiplayerModeController.ApplyPvpGameplayOverrides( options );
        options.NetGame = true;
        options.Deathmatch = 1;
        options.NoMonsters = true;
        options.FastMonsters = false;
        options.RespawnMonsters = false;
        options.ConsolePlayer = launchPlan.ConsolePlayer;

        for ( var i = 0; i < ManagedDoom.Player.MaxPlayerCount; i++ )
        {
            options.Players[i].InGame = i < 2;
        }

        _doom.ExternalTicCmdBuilder = BuildMultiplayerPvpCommands;
        _doom.Menu.Close();

        SboxManagedDoomMultiplayerPanelService.Close();
        _tickAccumulator = 0;
        _ignoreStartedMultiplayerMatch = true;
        _multiplayerModeController.BeginPvpLaunch( session, launchPlan.MapName );

        Log.Info( $"[MP-UI] Launching shared PVP map {launchPlan.MapName} as player slot {options.ConsolePlayer}." );
        _doom.NewGame( options.Skill, launchPlan.Episode, launchPlan.Map );
        Log.Info( $"[MP-PVP] _doom.NewGame completed for map {launchPlan.MapName}. host={Networking.IsHost}, newState={_doom.State}, newGameState={_doom.Game?.State}" );
        StateHasChanged();
    }

