    private static void ApplyAuthoritativeRemoteMobjVisualState(
        ManagedDoom.Mobj mobj,
        int stateNumber,
        int spriteValue,
        int frame,
        int tics )
    {
        if ( mobj is null )
        {
            return;
        }

        if ( stateNumber >= 0 && stateNumber < ManagedDoom.DoomInfo.States.Length )
        {
            mobj.State = ManagedDoom.DoomInfo.States[stateNumber];
        }

        if ( Enum.IsDefined( typeof( ManagedDoom.Sprite ), spriteValue ) )
        {
            mobj.Sprite = (ManagedDoom.Sprite)spriteValue;
        }

        mobj.Frame = frame;
        mobj.Tics = tics;
    }

    private static void SetAuthoritativePlayerPosition(
        ManagedDoom.ThingMovement thingMovement,
        ManagedDoom.Mobj mobj,
        int x,
        int y,
        int z,
        int momX,
        int momY,
        int momZ,
        int angle,
        int health )
    {
        thingMovement.UnsetThingPosition( mobj );
        mobj.X = new ManagedDoom.Fixed( x );
        mobj.Y = new ManagedDoom.Fixed( y );
        mobj.Z = new ManagedDoom.Fixed( z );
        mobj.MomX = new ManagedDoom.Fixed( momX );
        mobj.MomY = new ManagedDoom.Fixed( momY );
        mobj.MomZ = new ManagedDoom.Fixed( momZ );
        mobj.Angle = new ManagedDoom.Angle( angle );
        mobj.Health = health;
        thingMovement.SetThingPosition( mobj );
        mobj.FloorZ = mobj.Subsector.Sector.FloorHeight;
        mobj.CeilingZ = mobj.Subsector.Sector.CeilingHeight;
    }

    private static void ReconcileLocalJoinerPlayerState(
        ManagedDoom.ThingMovement thingMovement,
        ManagedDoom.Mobj mobj,
        int targetX,
        int targetY,
        int targetZ,
        int targetMomX,
        int targetMomY,
        int targetMomZ,
        int targetAngle,
        int targetHealth )
    {
        var deltaX = targetX - mobj.X.Data;
        var deltaY = targetY - mobj.Y.Data;
        var deltaZ = targetZ - mobj.Z.Data;

        var needsSnap =
            Math.Abs( deltaX ) > PvpLocalSnapDistance ||
            Math.Abs( deltaY ) > PvpLocalSnapDistance ||
            Math.Abs( deltaZ ) > PvpLocalSnapDistance;

        if ( needsSnap )
        {
            SetAuthoritativePlayerPosition( thingMovement, mobj, targetX, targetY, targetZ, targetMomX, targetMomY, targetMomZ, targetAngle, targetHealth );
            mobj.DisableFrameInterpolationForOneFrame();
            return;
        }

        var needsReconcile =
            Math.Abs( deltaX ) > PvpLocalReconcileDistance ||
            Math.Abs( deltaY ) > PvpLocalReconcileDistance ||
            Math.Abs( deltaZ ) > PvpLocalReconcileDistance;

        if ( needsReconcile )
        {
            thingMovement.UnsetThingPosition( mobj );
            mobj.X = new ManagedDoom.Fixed( BlendRaw( mobj.X.Data, targetX, 6 ) );
            mobj.Y = new ManagedDoom.Fixed( BlendRaw( mobj.Y.Data, targetY, 6 ) );
            mobj.Z = new ManagedDoom.Fixed( BlendRaw( mobj.Z.Data, targetZ, 6 ) );
            thingMovement.SetThingPosition( mobj );
            mobj.FloorZ = mobj.Subsector.Sector.FloorHeight;
            mobj.CeilingZ = mobj.Subsector.Sector.CeilingHeight;
        }

        mobj.Health = targetHealth;
    }

    private static void SmoothRemotePlayerState(
        ManagedDoom.ThingMovement thingMovement,
        ManagedDoom.Mobj mobj,
        int targetX,
        int targetY,
        int targetZ,
        int targetMomX,
        int targetMomY,
        int targetMomZ,
        int targetAngle,
        int targetHealth )
    {
        var deltaX = targetX - mobj.X.Data;
        var deltaY = targetY - mobj.Y.Data;
        var deltaZ = targetZ - mobj.Z.Data;

        var needsSnap =
            Math.Abs( deltaX ) > PvpRemoteSnapDistance ||
            Math.Abs( deltaY ) > PvpRemoteSnapDistance ||
            Math.Abs( deltaZ ) > PvpRemoteSnapDistance;

        if ( needsSnap )
        {
            SetAuthoritativePlayerPosition( thingMovement, mobj, targetX, targetY, targetZ, targetMomX, targetMomY, targetMomZ, targetAngle, targetHealth );
            return;
        }

        thingMovement.UnsetThingPosition( mobj );
        mobj.X = new ManagedDoom.Fixed( BlendRaw( mobj.X.Data, targetX, 3 ) );
        mobj.Y = new ManagedDoom.Fixed( BlendRaw( mobj.Y.Data, targetY, 3 ) );
        mobj.Z = new ManagedDoom.Fixed( BlendRaw( mobj.Z.Data, targetZ, 3 ) );
        mobj.MomX = new ManagedDoom.Fixed( BlendRaw( mobj.MomX.Data, targetMomX, 2 ) );
        mobj.MomY = new ManagedDoom.Fixed( BlendRaw( mobj.MomY.Data, targetMomY, 2 ) );
        mobj.MomZ = new ManagedDoom.Fixed( BlendRaw( mobj.MomZ.Data, targetMomZ, 2 ) );
        mobj.Angle = new ManagedDoom.Angle( targetAngle );
        mobj.Health = targetHealth;
        thingMovement.SetThingPosition( mobj );
        mobj.FloorZ = mobj.Subsector.Sector.FloorHeight;
        mobj.CeilingZ = mobj.Subsector.Sector.CeilingHeight;
    }

    private static int BlendRaw( int current, int target, int divisor )
    {
        if ( divisor <= 1 )
        {
            return target;
        }

        return current + ( (target - current) / divisor );
    }

    private static void SanitizeRemoteReplicatedWeaponState( ManagedDoom.Player player )
    {
        if ( player is null )
        {
            return;
        }

        if ( !IsUsableWeaponForRuntime( player.ReadyWeapon ) || !player.WeaponOwned[(int)player.ReadyWeapon] )
        {
            player.ReadyWeapon = ResolveOwnedWeaponFallback( player );
        }

        if ( player.PendingWeapon != ManagedDoom.WeaponType.NoChange )
        {
            if ( !IsUsableWeaponForRuntime( player.PendingWeapon ) || !player.WeaponOwned[(int)player.PendingWeapon] )
            {
                player.PendingWeapon = player.ReadyWeapon;
            }
        }
    }

    private static bool IsUsableWeaponForRuntime( ManagedDoom.WeaponType weapon )
    {
        return weapon != ManagedDoom.WeaponType.NoChange
            && weapon >= 0
            && weapon < ManagedDoom.WeaponType.Count;
    }

    private static ManagedDoom.WeaponType ResolveOwnedWeaponFallback( ManagedDoom.Player player )
    {
        if ( player.WeaponOwned[(int)ManagedDoom.WeaponType.Pistol] )
        {
            return ManagedDoom.WeaponType.Pistol;
        }

        if ( player.WeaponOwned[(int)ManagedDoom.WeaponType.Fist] )
        {
            return ManagedDoom.WeaponType.Fist;
        }

        for ( var weaponIndex = 0; weaponIndex < (int)ManagedDoom.WeaponType.Count; weaponIndex++ )
        {
            if ( player.WeaponOwned[weaponIndex] )
            {
                return (ManagedDoom.WeaponType)weaponIndex;
            }
        }

        return ManagedDoom.WeaponType.Pistol;
    }

    private bool ShouldSuppressLocalHitscanDamage( ManagedDoom.Player player )
    {
        if ( _doom?.Options is null || player is null )
        {
            return false;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( UseSharedSimulationPvp( session ) )
        {
            return false;
        }

        return session?.PvpActive == true
            && !Networking.IsHost
            && player.Number == _doom.Options.ConsolePlayer;
    }

    private bool ShouldSuppressLocalDamageToThing( ManagedDoom.Mobj target )
    {
        if ( _doom?.Options is null || target is null )
        {
            return false;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session?.PvpActive != true || Networking.IsHost )
        {
            return false;
        }

        if ( UseSharedSimulationPvp( session ) )
        {
            return false;
        }

        if ( target.Player is not null )
        {
            return true;
        }

        return target.Type == ManagedDoom.MobjType.Barrel;
    }

