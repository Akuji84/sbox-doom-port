@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using ManagedDoom
@using ManagedDoom.Audio
@using Sandbox.UI
@inherits PanelComponent

<root class="managed-doom-root @(SboxManagedDoomMultiplayerPanelService.IsOpen ? "mp-active" : "")">
    @if ( _error is not null )
    {
        <div class="status">
            <div class="title">Managed Doom Bootstrap Failed</div>
            <div class="message">@_error</div>
        </div>
    }
    else if ( _frameTexture is not null )
    {
        <div class="frame-wrap">
            <Image class="doom-frame" Texture="@_frameTexture" @key="_frameVersion" />
        </div>

        @if ( SboxManagedDoomMultiplayerPanelService.IsOpen )
        {
            <div class="mp-overlay" @key="SboxManagedDoomMultiplayerPanelService.Version">
                <div class="mp-box">
                    <div class="mp-header">
                        <div class="mp-header-label">MULTIPLAYER</div>
                        <div class="mp-header-line"></div>
                    </div>

                    @if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.Main )
                    {
                        <div class="mp-desc">SELECT AN OPTION</div>

                        <div class="mp-buttons">
                            <div class="mp-btn" onclick="@StartHostingAsync">HOST GAME</div>
                        </div>

                        <div class="mp-close" onclick="@CloseMultiplayerOverlay">PRESS ESC OR CLICK TO CLOSE</div>
                    }
                    else if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.HostInfo )
                    {
                        <div class="mp-info-title">HOST GAME</div>
                        <div class="mp-info-desc">@SboxManagedDoomMultiplayerPanelService.HostStatus</div>

                        <div class="mp-slots">
                            <div class="mp-slots-label">PLAYER SLOTS</div>
                            @for ( var i = 0; i < 2; i++ )
                            {
                                var isFilled = i < SboxManagedDoomMultiplayerPanelService.HostedPlayerNames.Count;
                                var playerName = isFilled
                                    ? SboxManagedDoomMultiplayerPanelService.HostedPlayerNames[i]
                                    : "EMPTY SLOT";
                                var tag = i == 0 && isFilled ? "HOST" : (isFilled ? "JOINED" : "OPEN");
                                var tagClass = isFilled && i == 0 ? "mp-slot-tag" : (isFilled ? "mp-slot-tag mp-slot-joined" : "mp-slot-tag mp-slot-open");

                                <div class="mp-slot">
                                    <div class="mp-slot-num">@(i + 1)</div>
                                    <div class="mp-slot-name">@playerName</div>
                                    <div class="@tagClass">@tag</div>
                                </div>
                            }
                        </div>

                        <div class="mp-buttons">
                            <div class="mp-btn" onclick="@StartHostedMatch">START GAME</div>
                            <div class="mp-btn mp-btn-dim" onclick="@BackToMultiplayerMain">BACK</div>
                        </div>

                        <div class="mp-close" onclick="@CloseMultiplayerOverlay">PRESS ESC OR CLICK TO CLOSE</div>
                    }
                    else if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.JoinLobby )
                    {
                        <div class="mp-info-title">JOINED GAME</div>
                        <div class="mp-info-desc">@SboxManagedDoomMultiplayerPanelService.JoinedLobbyName</div>

                        <div class="mp-slots">
                            <div class="mp-slots-label">PLAYER SLOTS</div>
                            @for ( var i = 0; i < 2; i++ )
                            {
                                var isFilled = i < SboxManagedDoomMultiplayerPanelService.JoinedPlayerNames.Count;
                                var playerName = isFilled
                                    ? SboxManagedDoomMultiplayerPanelService.JoinedPlayerNames[i]
                                    : "EMPTY SLOT";
                                var tag = i == 0 && isFilled ? "HOST" : (isFilled ? "JOINED" : "OPEN");
                                var tagClass = i == 0 && isFilled ? "mp-slot-tag" : (isFilled ? "mp-slot-tag mp-slot-joined" : "mp-slot-tag mp-slot-open");

                                <div class="mp-slot">
                                    <div class="mp-slot-num">@(i + 1)</div>
                                    <div class="mp-slot-name">@playerName</div>
                                    <div class="@tagClass">@tag</div>
                                </div>
                            }
                        </div>

                        <div class="mp-buttons">
                            <div class="mp-btn mp-btn-dim" onclick="@BackToMultiplayerMain">BACK</div>
                        </div>

                        <div class="mp-close" onclick="@CloseMultiplayerOverlay">PRESS ESC OR CLICK TO CLOSE</div>
                    }
                    else if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.MatchMenu )
                    {
                        <div class="mp-info-title">MULTIPLAYER MENU</div>
                        <div class="mp-info-desc">@SboxManagedDoomMultiplayerPanelService.MatchStatus</div>

                        <div class="mp-buttons">
                            <div class="mp-btn" onclick="@ShowMultiplayerPvpMode">PVP</div>
                            <div class="mp-btn" onclick="@ReturnMultiplayerGroupToLobby">BACK</div>
                            <div class="mp-btn mp-btn-dim" onclick="@LeaveMultiplayerMatch">LEAVE</div>
                        </div>

                        <div class="mp-close" onclick="@CloseMultiplayerOverlay">PRESS ESC OR CLICK TO CLOSE</div>
                    }
                    else
                    {
                        <div class="mp-info-title">MULTIPLAYER STATUS</div>
                        <div class="mp-info-desc">@SboxManagedDoomMultiplayerPanelService.JoinStatus</div>

                        <div class="mp-buttons">
                            <div class="mp-btn mp-btn-dim" onclick="@BackToMultiplayerMain">BACK</div>
                        </div>

                        <div class="mp-close" onclick="@CloseMultiplayerOverlay">PRESS ESC OR CLICK TO CLOSE</div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="status">
            <div class="title">Booting Managed Doom</div>
            <div class="message">Loading Freedoom and initializing renderer...</div>
        </div>
    }
</root>

@code {
    private const string WadPath = "doom/freedoom1.wad";
    private const float TickStep = 1.0f / 35.0f;
    private const float LeaderboardSyncIntervalSeconds = 30.0f;
    private const string RuntimeFailureTitle = "Managed Doom Runtime Failed";
    private const string LobbyDataStartedKey = "md_started";
    private const string LobbyDataNameKey = "md_name";
    private static readonly int PvpLocalSnapDistance = ManagedDoom.Fixed.FromInt(48).Data;
    private static readonly int PvpLocalReconcileDistance = ManagedDoom.Fixed.FromInt(2).Data;
    private static readonly int PvpRemoteSnapDistance = ManagedDoom.Fixed.FromInt(64).Data;
    private const int SharedSimulationPvpCommandLeadTics = 2;
    private const bool EnableSharedSimulationPvp = false;

    private ManagedDoom.Doom _doom;
    private ManagedDoom.Config _config;
    private SboxManagedDoomVideo _video;
    private SboxManagedDoomInput _input;
    private SboxManagedDoomSound _sound;
    private SboxManagedDoomMusic _music;
    private global::Sandbox.Texture _frameTexture;
    private int _frameVersion;
    private string _error;
    private float _tickAccumulator;
    private Task _bugReportTask;
    private Task _leaderboardTask;
    private Task _leaderboardStatsTask;
    private Task _leaderboardProfileTask;
    private SboxManagedDoomAnalyticsService _analytics;
    private SboxManagedDoomMultiplayerSessionComponent _multiplayerSession;
    private readonly SboxManagedDoomMultiplayerModeController _multiplayerModeController = new();
    private float _leaderboardSyncAccumulator;
    private float _timePlayedAccumulator;
    private int _sessionKillsTotal;
    private int _sessionDeathsTotal;
    private int _sessionItemsTotal;
    private int _sessionSecretsTotal;
    private int _sessionTimePlayedTotalSeconds;
    private int _ackedKillsTotal;
    private int _ackedDeathsTotal;
    private int _ackedItemsTotal;
    private int _ackedSecretsTotal;
    private int _ackedTimePlayedTotalSeconds;
    private int _ackedLevelsCompletedTotal;
    private int _lastObservedKills;
    private int _lastObservedItems;
    private int _lastObservedSecrets;
    private bool _hasObservedStatBaseline;
    private PlayerState _lastObservedPlayerState;
    private SboxManagedDoomMultiplayerLobbyListener _multiplayerLobbyListener;
    private global::Sandbox.GameObject _multiplayerSessionObject;
    private bool _ignoreStartedMultiplayerMatch;
    private readonly ManagedDoom.TicCmd _replicaLocalPvpCommand = new();
    private readonly Dictionary<ManagedDoom.MapThing, int> _pvpMapThingIndexes = new();
    private readonly HashSet<int> _initialPvpPickupThingIndexes = new();
    private readonly HashSet<int> _initialPvpDestroyableThingIndexes = new();
    private string _lastPublishedRemovedPickupThingIndexes = string.Empty;
    private string _lastAppliedRemovedPickupThingIndexes = string.Empty;
    private string _lastPublishedDestroyedWorldThingIndexes = string.Empty;
    private string _lastAppliedDestroyedWorldThingIndexes = string.Empty;
    private string _lastPublishedPvpSectorState = string.Empty;
    private string _lastAppliedPvpSectorState = string.Empty;
    private string _lastPublishedPvpLineState = string.Empty;
    private string _lastAppliedPvpLineState = string.Empty;
    private string _lastPublishedPvpProjectileState = string.Empty;
    private string _lastAppliedPvpProjectileState = string.Empty;
    private readonly bool[] _weaponEventSnapshotInitialized = new bool[2];
    private readonly bool[,] _lastPublishedWeaponOwned = new bool[2, (int)ManagedDoom.WeaponType.Count];
    private readonly int[,] _lastPublishedAmmo = new int[2, (int)ManagedDoom.AmmoType.Count];
    private readonly ManagedDoom.WeaponType[] _lastPublishedReadyWeapon = new ManagedDoom.WeaponType[2];
    private readonly ManagedDoom.PlayerState[] _lastPublishedWeaponPlayerState = new ManagedDoom.PlayerState[2];
    private readonly int[] _lastConsumedWeaponEventSerial = new int[2];
    private readonly ManagedDoom.WeaponType?[] _pendingLocalWeaponTargets = new ManagedDoom.WeaponType?[2];
    private readonly int[] _weaponRespawnSettleTics = new int[2];
    private readonly bool[] _combatEventSnapshotInitialized = new bool[2];
    private readonly int[] _lastPublishedCombatHealth = new int[2];
    private readonly int[] _lastPublishedCombatDamageCount = new int[2];
    private readonly ManagedDoom.PlayerState[] _lastPublishedCombatPlayerState = new ManagedDoom.PlayerState[2];
    private readonly int[,] _lastPublishedCombatFrags = new int[2, ManagedDoom.Player.MaxPlayerCount];
    private readonly int[] _lastConsumedCombatEventSerial = new int[2];
    private readonly List<ManagedDoom.HitscanImpactEvent> _pendingAuthoritativeHitscanEvents = new();
    private readonly bool[] _pickupPresentationSnapshotInitialized = new bool[2];
    private readonly int[] _lastPublishedPresentationHealth = new int[2];
    private readonly int[] _lastPublishedPresentationArmor = new int[2];
    private readonly int[] _lastPublishedPresentationBonusCount = new int[2];
    private int _lastConsumedHitscanEventSerial;
    private int _lastConsumedEffectEventSerial;
    private readonly Dictionary<ManagedDoom.Sfx, DateTime> _predictedLocalSfxTimes = new();
    private readonly Dictionary<int, DateTime> _predictedPickupThingTimes = new();
    private readonly Dictionary<int, int> _predictedBarrelDamageTotals = new();
    private readonly Dictionary<int, DateTime> _predictedBarrelDamageTimes = new();
    private readonly Dictionary<int, DateTime> _predictedBarrelExplosionTimes = new();
    private readonly List<RecentHitscanImpact> _recentLocalHitscanImpacts = new();
    private readonly Dictionary<ManagedDoom.Mobj, DateTime> _transientPresentationMobjs = new();
    private DateTime _suppressReplicatedItemPickupSfxUntilUtc = DateTime.MinValue;
    private int _lastHandledPvpWinnerSerial;
    private string _activePvpWinnerMessage = string.Empty;
    private DateTime _activePvpWinnerMessageUntilUtc = DateTime.MinValue;
    private DateTime _pendingPvpRoundRestartAtUtc = DateTime.MinValue;
    private string _lastReportedPvpChecksumMismatchSignature = string.Empty;
    private string _lastReportedJoinedLobbyAnalyticsKey = string.Empty;
    private readonly ManagedDoom.Mobj[] _lastObservedSharedSimulationPlayerMobjs = new ManagedDoom.Mobj[2];
    private readonly ManagedDoom.PlayerState[] _lastObservedSharedSimulationPlayerStates = new ManagedDoom.PlayerState[2];
    private int _lastLoggedSharedSimulationMismatchLevelTime = -1;
    private readonly Dictionary<int, SharedSimulationTicCommand> _sharedSimulationLocalPvpCommands = new();
    private bool _sharedSimulationPvpReadyReported;
    private int _lastHandledSharedSimulationPvpStartSerial;
    private int _nextSharedSimulationPvpTic;
    private int _lastQueuedSharedSimulationLocalPvpTic = -1;
    private int _activeSharedSimulationPvpCommandTic = -1;
    private readonly LocalPlayerPresentationSnapshot[] _localPlayerPresentationSnapshots =
    {
        new(),
        new()
    };

    protected override void OnStart()
    {
        SboxManagedDoomMultiplayerPanelService.Reset();

        try
        {
            var args = new ManagedDoom.CommandLineArgs( new[] { "-iwad", WadPath } );
            ManagedDoom.ConfigUtilities.SetHostWadPaths( WadPath );

            var config = new ManagedDoom.Config( ManagedDoom.ConfigUtilities.GetConfigPath() );
            _config = config;
            var content = new ManagedDoom.GameContent( args );

            RegisterPngPatches( content );

            _video = new SboxManagedDoomVideo( config, content );
            _video.OverlayDrawer = DrawDoomPvpScoreboardOverlay;
            _input = new SboxManagedDoomInput( config );
            _sound = CreateSoundAdapter( config, content );
            _music = CreateMusicAdapter( config, content );
            _analytics = new SboxManagedDoomAnalyticsService();

            _doom = new ManagedDoom.Doom(
                args,
                config,
                content,
                _video,
                _sound,
                _music,
                _input );

            _doom.Options.AnalyticsListener = _analytics;
            _doom.Options.ShouldSuppressLocalHitscanDamage = ShouldSuppressLocalHitscanDamage;
            _doom.Options.ShouldSuppressLocalDamageToThing = ShouldSuppressLocalDamageToThing;
            _doom.Options.ShouldSuppressLocalPickup = ShouldSuppressLocalPickup;
            _doom.Options.SuppressedLocalPickupPresentationListener = OnSuppressedLocalPickupPresentation;
            _doom.Options.SuppressedLocalDamagePresentationListener = OnSuppressedLocalDamagePresentation;
            _doom.Options.HitscanImpactListener = OnHitscanImpact;

            _video.Render( _doom, ManagedDoom.Fixed.Zero );
            SyncFrame();
            _analytics.OnSessionStart(
                BuildSessionStartMap(),
                _doom.State.ToString() );
            QueueLeaderboardProfileSync();
            StateHasChanged();
            Log.Info( "[ManagedDoomHost] Bootstrapped Managed Doom." );
        }
        catch ( Exception ex )
        {
            _error = ex.ToString();
            Log.Error( $"[ManagedDoomHost] Bootstrap failed: {_error}" );
            StateHasChanged();
        }
    }

    protected override void OnUpdate()
    {
        if ( _doom is null || _video is null || _error is not null )
        {
            return;
        }

        try
        {
            var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;

            if ( session?.PvpLaunchSerial > _multiplayerModeController.HandledPvpLaunchSerial )
            {
                TryEnterMultiplayerPvpMatch();
            }
            else if ( session?.PvpActive == true
                && !_multiplayerModeController.PvpMatchLoaded
                && !_multiplayerModeController.PvpLaunchPending )
            {
                TryEnterMultiplayerPvpMatch();
            }

            ReportMultiplayerAnalytics( session );

            if ( SboxManagedDoomMultiplayerSessionComponent.Current?.MatchStarted != true )
            {
                _ignoreStartedMultiplayerMatch = false;
            }

            if ( SboxManagedDoomMultiplayerSessionComponent.Current?.MatchStarted == true
                && !_ignoreStartedMultiplayerMatch
                && SboxManagedDoomMultiplayerPanelService.View != SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.MatchMenu )
            {
                SboxManagedDoomMultiplayerPanelService.ShowMatchMenu( SboxManagedDoomMultiplayerModeCatalog.SelectModeStatus );
                StateHasChanged();
            }

            _tickAccumulator += Time.Delta;
            DispatchKeyEvents();
            PumpBugReportSubmission();
            PumpLeaderboardRefresh();
            PumpLeaderboardProfileSync();
            UpdateSound();
            UpdateMusic();

            var updated = false;
            if ( !SboxManagedDoomMultiplayerPanelService.IsOpen )
            {
                while ( _tickAccumulator >= TickStep )
                {
                    var activeSession = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
                    if ( UseSharedSimulationPvp( activeSession ) )
                    {
                        if ( !EnsureSharedSimulationPvpStartBarrier( activeSession ) )
                        {
                            break;
                        }

                        QueueSharedSimulationPvpLocalCommands( activeSession );
                        if ( !CanAdvanceSharedSimulationPvpTic( activeSession ) )
                        {
                            break;
                        }

                        _activeSharedSimulationPvpCommandTic = _nextSharedSimulationPvpTic;
                    }
                    else if ( activeSession?.PvpActive == true )
                    {
                        ApplyOwnedRemotePlayerMovementForHost( activeSession );
                    }

                    _doom.Update();
                    if ( _activeSharedSimulationPvpCommandTic >= 0 )
                    {
                        TrackSharedSimulationPvpPlayerRespawns();
                        _nextSharedSimulationPvpTic++;
                        _activeSharedSimulationPvpCommandTic = -1;
                        CleanupSharedSimulationPvpLocalCommands();
                    }

                    _tickAccumulator -= TickStep;
                    updated = true;
                }
            }
            else
            {
                _tickAccumulator = 0;
                if ( SboxManagedDoomMultiplayerPanelService.View == SboxManagedDoomMultiplayerPanelService.MultiplayerPanelView.Main
                    && Networking.IsActive
                    && ( _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current ) is not null )
                {
                    RefreshMultiplayerSessionView();
                }
                UpdateMultiplayerRostersFromConnections();
                StateHasChanged();
            }

            if ( updated )
            {
                UpdatePvpLoadedState();

                if ( (_multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current)?.PvpActive == true )
                {
                    var activeSession = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
                    if ( UseSharedSimulationPvp( activeSession ) )
                    {
                        PumpSharedSimulationPvpChecksum( activeSession );
                    }
                    else
                    {
                        PublishOwnedLocalPvpMovementState( activeSession );
                        PumpAuthoritativePvpState();
                        PumpAuthoritativePvpHitscanEvents();
                        PumpAuthoritativePvpProjectileState();
                        PumpAuthoritativePvpPickupState();
                        PumpAuthoritativePvpDestroyedWorldThingState();
                        PumpAuthoritativePvpWorldState();
                        UpdatePvpRoundWinState( activeSession );
                    }
                }

                CleanupExpiredPredictionState();
                CleanupExpiredTransientPresentationMobjs();
                _video.Render( _doom, ManagedDoom.Fixed.Zero );
                SyncFrame();
                StateHasChanged();
            }

            CaptureLeaderboardSessionState();
            PumpLeaderboardStatsSubmission();
            _analytics?.PumpSessionHeartbeat( BuildSessionStartMap(), _doom.State.ToString() );
        }
        catch ( Exception ex )
        {
            FailRuntime( RuntimeFailureTitle, ex );
            StateHasChanged();
        }
    }

    protected override void OnDestroy()
    {
        SboxManagedDoomMultiplayerPanelService.Reset();

        try
        {
            CaptureLeaderboardSessionState();
            FlushLeaderboardStats();
        }
        catch
        {
        }

        try
        {
            _analytics?.OnSessionEnd();
        }
        catch
        {
        }

        try
        {
            _config?.Save( ManagedDoom.ConfigUtilities.GetConfigPath() );
        }
        catch
        {
        }

        CleanupTransientPresentationMobjs( force: true );
        DestroyMultiplayerSessionObject();
        if ( _video is not null )
        {
            _video.OverlayDrawer = null;
        }

        if ( _doom?.Options is not null )
        {
            _doom.Options.ShouldSuppressLocalHitscanDamage = null;
            _doom.Options.ShouldSuppressLocalDamageToThing = null;
            _doom.Options.ShouldSuppressLocalPickup = null;
            _doom.Options.SuppressedLocalPickupPresentationListener = null;
            _doom.Options.SuppressedLocalDamagePresentationListener = null;
            _doom.Options.HitscanImpactListener = null;
        }
    }

    private void SyncFrame()
    {
        _frameTexture = _video.FrameTexture;
        _frameVersion = _video.FrameVersion;
    }

    private string BuildSessionStartMap()
    {
        if ( _doom is null )
        {
            return string.Empty;
        }

        var options = _doom.Options;
        if ( options.GameMode == ManagedDoom.GameMode.Commercial )
        {
            return $"MAP{options.Map:00}";
        }

        return $"E{options.Episode}M{options.Map}";
    }

    private SboxManagedDoomSound CreateSoundAdapter( ManagedDoom.Config config, ManagedDoom.GameContent content )
    {
        try
        {
            return new SboxManagedDoomSound( config, content );
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Sound disabled after initialization failure: {ex}" );
            return null;
        }
    }

    private SboxManagedDoomMusic CreateMusicAdapter( ManagedDoom.Config config, ManagedDoom.GameContent content )
    {
        try
        {
            return new SboxManagedDoomMusic( config, content );
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Music disabled after initialization failure: {ex}" );
            return null;
        }
    }

    private void UpdateSound()
    {
        if ( _sound is null )
        {
            return;
        }

        try
        {
            _sound.Update();
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Sound disabled after runtime failure: {ex}" );
            _sound = null;
        }
    }

    private void UpdateMusic()
    {
        if ( _music is null )
        {
            return;
        }

        try
        {
            _music.Update();
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Music disabled after runtime failure: {ex}" );
            _music = null;
        }
    }

    private void FailRuntime( string title, Exception ex )
    {
        _error = $"{title}\n{ex}";
        Log.Error( $"[ManagedDoomHost] {title}: {ex}" );
    }

    private void PumpBugReportSubmission()
    {
        if ( _bugReportTask is not null && !_bugReportTask.IsCompleted )
        {
            return;
        }

        if ( SboxManagedDoomBugReportService.TryBeginSubmit( out var request ) )
        {
            _bugReportTask = SboxManagedDoomBugReportService.SubmitAsync( request );
        }
    }

    private void PumpLeaderboardRefresh()
    {
        if ( _leaderboardTask is not null && !_leaderboardTask.IsCompleted )
        {
            return;
        }

        if ( SboxManagedDoomLeaderboardService.TryBeginRefresh() )
        {
            _leaderboardTask = SboxManagedDoomLeaderboardService.RefreshAsync();
        }
    }

    private void QueueLeaderboardProfileSync()
    {
        if ( _leaderboardProfileTask is not null && !_leaderboardProfileTask.IsCompleted )
        {
            return;
        }

        _leaderboardProfileTask = SubmitLeaderboardProfileAsync();
    }

    private void PumpLeaderboardProfileSync()
    {
        if ( _leaderboardProfileTask is null || !_leaderboardProfileTask.IsCompleted )
        {
            return;
        }

        if ( _leaderboardProfileTask.IsFaulted )
        {
            Log.Warning( $"[ManagedDoomHost] Leaderboard profile sync failed: {_leaderboardProfileTask.Exception}" );
        }

        _leaderboardProfileTask = null;
    }

    private async Task SubmitLeaderboardProfileAsync()
    {
        var displayName = GetLeaderboardDisplayName();
        await SboxManagedDoomLeaderboardService.SyncProfileAsync( displayName );
        Log.Info( $"[ManagedDoomHost] Leaderboard profile sync succeeded for '{displayName}'." );
    }

    private void CaptureLeaderboardSessionState()
    {
        if ( _doom is null || _error is not null )
        {
            return;
        }

        _leaderboardSyncAccumulator += Time.Delta;
        _timePlayedAccumulator += Time.Delta;

        while ( _timePlayedAccumulator >= 1.0f )
        {
            _sessionTimePlayedTotalSeconds++;
            _timePlayedAccumulator -= 1.0f;
        }

        var player = TryGetConsolePlayer();
        if ( player is null )
        {
            _hasObservedStatBaseline = false;
            return;
        }

        var observedKills = Math.Max( 0, player.KillCount );
        var observedItems = Math.Max( 0, player.ItemCount );
        var observedSecrets = Math.Max( 0, player.SecretCount );

        if ( !_hasObservedStatBaseline )
        {
            _lastObservedKills = observedKills;
            _lastObservedItems = observedItems;
            _lastObservedSecrets = observedSecrets;
            _lastObservedPlayerState = player.PlayerState;
            _hasObservedStatBaseline = true;
        }
        else
        {
            AccumulatePositiveDiff( ref _sessionKillsTotal, ref _lastObservedKills, observedKills );
            AccumulatePositiveDiff( ref _sessionItemsTotal, ref _lastObservedItems, observedItems );
            AccumulatePositiveDiff( ref _sessionSecretsTotal, ref _lastObservedSecrets, observedSecrets );

            if ( _lastObservedPlayerState != PlayerState.Dead && player.PlayerState == PlayerState.Dead )
            {
                _sessionDeathsTotal++;
            }

            _lastObservedPlayerState = player.PlayerState;
        }
    }

    private void PumpLeaderboardStatsSubmission()
    {
        if ( _leaderboardStatsTask is not null && !_leaderboardStatsTask.IsCompleted )
        {
            return;
        }

        if ( _leaderboardSyncAccumulator < LeaderboardSyncIntervalSeconds )
        {
            return;
        }

        _leaderboardSyncAccumulator -= LeaderboardSyncIntervalSeconds;
        var request = BuildLeaderboardStatsRequest();
        _leaderboardStatsTask = SubmitLeaderboardStatsAsync( request );
    }

    private async Task SubmitLeaderboardStatsAsync( StatsUpdateRequest request )
    {
        try
        {
            await SboxManagedDoomLeaderboardService.SubmitStatsAsync( request );
            AcknowledgeLeaderboardStats( request );
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Leaderboard stats sync failed: {ex}" );
        }
    }

    private void FlushLeaderboardStats()
    {
        var request = BuildLeaderboardStatsRequest();

        if ( request.KillsDelta == 0 &&
             request.DeathsDelta == 0 &&
             request.ItemsDelta == 0 &&
             request.SecretsDelta == 0 &&
             request.TimePlayedSecondsDelta == 0 &&
             request.LevelsCompletedDelta == 0 &&
             request.BestTimes.Count == 0 )
        {
            return;
        }

        try
        {
            SboxManagedDoomLeaderboardService.SubmitStatsAsync( request ).GetAwaiter().GetResult();
            AcknowledgeLeaderboardStats( request );
        }
        catch ( Exception ex )
        {
            Log.Warning( $"[ManagedDoomHost] Leaderboard stats flush failed: {ex}" );
        }
    }

    private StatsUpdateRequest BuildLeaderboardStatsRequest()
    {
        var levelsCompletedTotal = _analytics?.GetCompletedLevelsTotal() ?? 0;
        var bestTimes = new Dictionary<string, int>(
            _analytics?.GetBestTimesSnapshot() ?? new Dictionary<string, int>(),
            StringComparer.OrdinalIgnoreCase );

        return new StatsUpdateRequest
        {
            Kills = _sessionKillsTotal,
            KillsDelta = Math.Max( 0, _sessionKillsTotal - _ackedKillsTotal ),
            Deaths = _sessionDeathsTotal,
            DeathsDelta = Math.Max( 0, _sessionDeathsTotal - _ackedDeathsTotal ),
            Items = _sessionItemsTotal,
            ItemsDelta = Math.Max( 0, _sessionItemsTotal - _ackedItemsTotal ),
            Secrets = _sessionSecretsTotal,
            SecretsDelta = Math.Max( 0, _sessionSecretsTotal - _ackedSecretsTotal ),
            TimePlayedSeconds = _sessionTimePlayedTotalSeconds,
            TimePlayedSecondsDelta = Math.Max( 0, _sessionTimePlayedTotalSeconds - _ackedTimePlayedTotalSeconds ),
            LevelsCompleted = levelsCompletedTotal,
            LevelsCompletedDelta = Math.Max( 0, levelsCompletedTotal - _ackedLevelsCompletedTotal ),
            BestTimes = bestTimes
        };
    }

    private void AcknowledgeLeaderboardStats( StatsUpdateRequest request )
    {
        _ackedKillsTotal = Math.Max( _ackedKillsTotal, request.Kills );
        _ackedDeathsTotal = Math.Max( _ackedDeathsTotal, request.Deaths );
        _ackedItemsTotal = Math.Max( _ackedItemsTotal, request.Items );
        _ackedSecretsTotal = Math.Max( _ackedSecretsTotal, request.Secrets );
        _ackedTimePlayedTotalSeconds = Math.Max( _ackedTimePlayedTotalSeconds, request.TimePlayedSeconds );
        _ackedLevelsCompletedTotal = Math.Max( _ackedLevelsCompletedTotal, request.LevelsCompleted );
    }

    private Player TryGetConsolePlayer()
    {
        if ( _doom?.Game?.Options is null )
        {
            return null;
        }

        var options = _doom.Game.Options;
        if ( options.ConsolePlayer < 0 || options.ConsolePlayer >= options.Players.Length )
        {
            return null;
        }

        return options.Players[options.ConsolePlayer];
    }

    private static string GetLeaderboardDisplayName()
    {
        var displayName = Sandbox.Utility.Steam.PersonaName;
        if ( string.IsNullOrWhiteSpace( displayName ) )
        {
            return $"Steam {Game.SteamId}";
        }

        return displayName.Trim();
    }

    private static void AccumulatePositiveDiff( ref int runningTotal, ref int lastObserved, int current )
    {
        if ( current > lastObserved )
        {
            runningTotal += current - lastObserved;
        }

        lastObserved = current;
    }

