    private void OnHitscanImpact( ManagedDoom.HitscanImpactEvent impact )
    {
        if ( impact is null )
        {
            return;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session?.PvpActive != true )
        {
            return;
        }

        if ( UseSharedSimulationPvp( session ) )
        {
            if ( !Networking.IsHost )
            {
                RememberLocalHitscanImpact( impact );
                TryPredictBarrelExplosionFromHitscanImpact( impact );
            }

            return;
        }

        if ( Networking.IsHost )
        {
            _pendingAuthoritativeHitscanEvents.Add( impact );
            return;
        }

        RememberLocalHitscanImpact( impact );
        TryPredictBarrelExplosionFromHitscanImpact( impact );
    }

    private void RememberLocalHitscanImpact( ManagedDoom.HitscanImpactEvent impact )
    {
        _recentLocalHitscanImpacts.Add( new RecentHitscanImpact
        {
            Blood = impact.Blood,
            X = impact.X,
            Y = impact.Y,
            Z = impact.Z,
            RecordedAtUtc = DateTime.UtcNow
        } );
    }

    private bool WasPredictedLocalHitscanRecently( bool blood, int x, int y, int z )
    {
        const double predictionWindowMs = 250.0;
        const int maxDistance = 24 << 16;
        var now = DateTime.UtcNow;

        for ( var i = _recentLocalHitscanImpacts.Count - 1; i >= 0; i-- )
        {
            var impact = _recentLocalHitscanImpacts[i];
            if ( ( now - impact.RecordedAtUtc ).TotalMilliseconds > predictionWindowMs )
            {
                continue;
            }

            if ( impact.Blood != blood )
            {
                continue;
            }

            if ( Math.Abs( impact.X - x ) <= maxDistance
                && Math.Abs( impact.Y - y ) <= maxDistance
                && Math.Abs( impact.Z - z ) <= maxDistance )
            {
                _recentLocalHitscanImpacts.RemoveAt( i );
                return true;
            }
        }

        return false;
    }

    private void CleanupExpiredLocalHitscanImpacts()
    {
        const double maxAgeMs = 400.0;
        if ( _recentLocalHitscanImpacts.Count == 0 )
        {
            return;
        }

        var now = DateTime.UtcNow;
        _recentLocalHitscanImpacts.RemoveAll( impact => ( now - impact.RecordedAtUtc ).TotalMilliseconds > maxAgeMs );
    }

    private void TryPredictBarrelExplosionFromHitscanImpact( ManagedDoom.HitscanImpactEvent impact )
    {
        if ( impact.Blood || _doom?.Game?.World is null )
        {
            return;
        }

        const int maxDistance = 20 << 16;
        ManagedDoom.Mobj bestBarrel = null;
        var bestDistance = int.MaxValue;

        foreach ( var thinker in _doom.Game.World.Thinkers )
        {
            if ( thinker is not ManagedDoom.Mobj barrel
                || barrel.Type != ManagedDoom.MobjType.Barrel
                || barrel.ThinkerState == ManagedDoom.ThinkerState.Removed
                || barrel.SpawnPoint is null
                || !_pvpMapThingIndexes.TryGetValue( barrel.SpawnPoint, out var mapThingIndex )
                || _predictedBarrelExplosionTimes.ContainsKey( mapThingIndex ) )
            {
                continue;
            }

            var deltaX = Math.Abs( barrel.X.Data - impact.X );
            var deltaY = Math.Abs( barrel.Y.Data - impact.Y );
            if ( deltaX > maxDistance || deltaY > maxDistance )
            {
                continue;
            }

            var distance = deltaX + deltaY;
            if ( distance >= bestDistance )
            {
                continue;
            }

            bestDistance = distance;
            bestBarrel = barrel;
        }

        if ( bestBarrel is not null )
        {
            PlayPredictedBarrelExplosion( bestBarrel );
        }
    }

