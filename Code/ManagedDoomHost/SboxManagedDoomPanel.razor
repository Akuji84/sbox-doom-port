        session.PublishAuthoritativePlayerState( 0, players[0] );
        var publishPlayer1MovementAndVisuals = players.Length <= 1
            || players[1]?.PlayerState != ManagedDoom.PlayerState.Live;
        session.PublishAuthoritativePlayerState( 1, players[1], publishPlayer1MovementAndVisuals );
        PublishAuthoritativeCombatEvents( session, players );
        PublishAuthoritativeWeaponEvents( session, players );
        PublishAuthoritativePickupPresentationEvents( session, players );
    }

    private void PublishOwnedLocalPvpMovementState( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( Networking.IsHost
            || session?.PvpActive != true
            || !_multiplayerModeController.PvpMatchLoaded
            || _doom?.Game?.World is null
            || _doom.Options.ConsolePlayer != 1 )
        {
            return;
        }

        var players = _doom.Options.Players;
        if ( players.Length <= 1 )
        {
            return;
        }

        var player = players[1];
        var mobj = player?.Mobj;
        if ( player is null || mobj is null || player.PlayerState != ManagedDoom.PlayerState.Live )
        {
            return;
        }

        session.PublishOwnedPlayerMovementStateRpc(
            1,
            true,
            mobj.X.Data,
            mobj.Y.Data,
            mobj.Z.Data,
            mobj.MomX.Data,
            mobj.MomY.Data,
            mobj.MomZ.Data,
            unchecked( (int)mobj.Angle.Data ),
            mobj.State?.Number ?? 0,
            (int)mobj.Sprite,
            mobj.Frame,
            mobj.Tics );
    }

    private void UpdatePvpRoundWinState( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( session is null )
        {
            return;
        }

        var players = _doom?.Options?.Players;
        var roundFullyLive =
            session.PvpActive
            && _multiplayerModeController.PvpMatchLoaded
            && _doom?.State == ManagedDoom.DoomState.Game
            && _doom.Game is not null
            && _doom.Game.State == ManagedDoom.GameState.Level
            && _doom.Game.World is not null
            && _doom.Game.World.LevelTime > 35
            && players is not null
            && players.Length > 1
            && players[0]?.Mobj is not null
            && players[1]?.Mobj is not null;

        if ( session.PvpWinnerSerial != _lastHandledPvpWinnerSerial )
        {
            _lastHandledPvpWinnerSerial = session.PvpWinnerSerial;
            _activePvpWinnerMessage = $"{GetDoomScoreboardDisplayName( session.PvpWinnerName )} HAS WON THE GAME!";
            _activePvpWinnerMessageUntilUtc = DateTime.UtcNow.AddSeconds( 7.0 );

            if ( Networking.IsHost )
            {
                _pendingPvpRoundRestartAtUtc = _activePvpWinnerMessageUntilUtc;
            }
        }

        if ( Networking.IsHost && roundFullyLive && !session.PvpRoundEnded )
        {
            var entries = GetPvpScoreboardEntries();
            if ( entries.Count > 0 && entries[0].Kills >= 10 )
            {
                var loserName = entries.Count > 1 ? entries[1].Name : "PLAYER";
                var loserKills = entries.Count > 1 ? entries[1].Kills : 0;
                _analytics?.OnPvpMatchWon(
                    entries[0].Name,
                    entries[0].Kills,
                    loserName,
                    loserKills,
                    string.IsNullOrWhiteSpace( session.PvpMap ) ? "E1M1" : session.PvpMap );
                session.AnnouncePvpWinnerRpc( entries[0].Name );
                return;
            }
        }

        if ( Networking.IsHost
            && session.PvpRoundEnded
            && _pendingPvpRoundRestartAtUtc != DateTime.MinValue
            && DateTime.UtcNow >= _pendingPvpRoundRestartAtUtc )
        {
            RestartPvpRoundAfterWin( session );
        }
    }

    private void RestartPvpRoundAfterWin( SboxManagedDoomMultiplayerSessionComponent session )
    {
        var mapName = string.IsNullOrWhiteSpace( session?.PvpMap ) ? "E1M1" : session.PvpMap;
        _activePvpWinnerMessage = string.Empty;
        _activePvpWinnerMessageUntilUtc = DateTime.MinValue;
        _pendingPvpRoundRestartAtUtc = DateTime.MinValue;
        _lastHandledPvpWinnerSerial = session?.PvpWinnerSerial ?? 0;

        if ( session is null )
        {
            return;
        }

        ResetMultiplayerGameplayOverrides();
        session.StartPvpRpc( mapName );
        PublishHostedLobbyDiscoveryState();
        TryEnterMultiplayerPvpMatch();
    }

    private void ApplyOwnedRemotePlayerMovementForHost( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( !Networking.IsHost
            || session?.PvpActive != true
            || !_multiplayerModeController.PvpMatchLoaded
            || _doom?.Game?.World is null )
        {
            return;
        }

        var players = _doom.Options.Players;
        if ( players.Length <= 1 )
        {
            return;
        }

        var player = players[1];
        var mobj = player?.Mobj;
        if ( player is null
            || mobj is null
            || player.PlayerState != ManagedDoom.PlayerState.Live
            || !session.Player1StateActive
            || session.Player1StatePlayerState != (int)ManagedDoom.PlayerState.Live )
        {
            return;
        }

        SetAuthoritativePlayerPosition(
            _doom.Game.World.ThingMovement,
            mobj,
            session.Player1StateX,
            session.Player1StateY,
            session.Player1StateZ,
            session.Player1StateMomX,
            session.Player1StateMomY,
            session.Player1StateMomZ,
            session.Player1StateAngle,
            session.Player1StateHealth );

        mobj.DisableFrameInterpolationForOneFrame();
        player.DisableFrameInterpolationForOneFrame();
    }

    private void PublishAuthoritativePvpProjectileState( SboxManagedDoomMultiplayerSessionComponent session )
    {
        var world = _doom.Game.World;
        var snapshots = new List<PvpProjectileSnapshot>();

        foreach ( var thinker in world.Thinkers )
        {
            if ( thinker is not ManagedDoom.Mobj projectile || !IsAuthoritativePvpProjectile( projectile ) )
            {
                continue;
            }

            snapshots.Add( new PvpProjectileSnapshot
            {
                OwnerPlayerIndex = ResolveProjectileOwnerIndex( projectile.Target ),
                Type = projectile.Type,
                X = projectile.X.Data,
                Y = projectile.Y.Data,
                Z = projectile.Z.Data,
                MomX = projectile.MomX.Data,
                MomY = projectile.MomY.Data,
                MomZ = projectile.MomZ.Data,
                Angle = unchecked( (int)projectile.Angle.Data ),
                Tics = projectile.Tics
            } );
        }

        snapshots.Sort( CompareProjectileSnapshots );

        var projectileEntries = new string[snapshots.Count];
        for ( var i = 0; i < snapshots.Count; i++ )
        {
            var snapshot = snapshots[i];
            projectileEntries[i] =
                $"{snapshot.OwnerPlayerIndex}:{(int)snapshot.Type}:{snapshot.X}:{snapshot.Y}:{snapshot.Z}:{snapshot.MomX}:{snapshot.MomY}:{snapshot.MomZ}:{snapshot.Angle}:{snapshot.Tics}";
        }

        var projectileState = string.Join( ';', projectileEntries );

        if ( !string.Equals( projectileState, _lastPublishedPvpProjectileState, StringComparison.Ordinal ) )
        {
            session.PvpProjectileState = projectileState;
            _lastPublishedPvpProjectileState = projectileState;
        }
    }

    private void PublishAuthoritativeCombatEvents( SboxManagedDoomMultiplayerSessionComponent session, ManagedDoom.Player[] players )
    {
        for ( var playerIndex = 0; playerIndex < 2 && playerIndex < players.Length; playerIndex++ )
        {
            var player = players[playerIndex];
            if ( player?.Mobj is null )
            {
                continue;
            }

            if ( !_combatEventSnapshotInitialized[playerIndex] )
            {
                CaptureCombatEventSnapshot( playerIndex, player );
                continue;
            }

            var currentState = player.PlayerState;
            var previousState = _lastPublishedCombatPlayerState[playerIndex];
            var currentHealth = player.Mobj.Health;
            var previousHealth = _lastPublishedCombatHealth[playerIndex];
            var currentDamageCount = player.DamageCount;
            var previousDamageCount = _lastPublishedCombatDamageCount[playerIndex];

            if ( previousState != ManagedDoom.PlayerState.Dead && currentState == ManagedDoom.PlayerState.Dead )
            {
                QueueCombatSnapshot( session, playerIndex, SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType.Death, player );
            }
            else if ( previousState == ManagedDoom.PlayerState.Dead && currentState == ManagedDoom.PlayerState.Live )
            {
                QueueCombatSnapshot( session, playerIndex, SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType.Respawn, player );
            }
            else if ( currentHealth < previousHealth || currentDamageCount > previousDamageCount )
            {
                QueueCombatSnapshot( session, playerIndex, SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType.Damage, player );
            }

            CaptureCombatEventSnapshot( playerIndex, player );
        }
    }

    private void PublishAuthoritativePvpHitscanEvents( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( _pendingAuthoritativeHitscanEvents.Count == 0 )
        {
            return;
        }

        for ( var i = 0; i < _pendingAuthoritativeHitscanEvents.Count; i++ )
        {
            var impact = _pendingAuthoritativeHitscanEvents[i];
            session.QueueHitscanEvent( impact.Blood, impact.X, impact.Y, impact.Z, impact.Damage );
        }

        _pendingAuthoritativeHitscanEvents.Clear();
    }

    private void PublishAuthoritativeWeaponEvents( SboxManagedDoomMultiplayerSessionComponent session, ManagedDoom.Player[] players )
    {
        for ( var playerIndex = 0; playerIndex < 2 && playerIndex < players.Length; playerIndex++ )
        {
            var player = players[playerIndex];
            if ( player is null )
            {
                continue;
            }

            if ( !_weaponEventSnapshotInitialized[playerIndex] )
            {
                CaptureWeaponEventSnapshot( playerIndex, player );
                continue;
            }

            for ( var weaponIndex = 0; weaponIndex < (int)ManagedDoom.WeaponType.Count; weaponIndex++ )
            {
                var ownedNow = player.WeaponOwned[weaponIndex];
                var ownedBefore = _lastPublishedWeaponOwned[playerIndex, weaponIndex];
                if ( !ownedBefore && ownedNow )
                {
                    session.QueueWeaponEvent(
                        playerIndex,
                        SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.PickupWeapon,
                        weaponIndex,
                        -1,
                        0,
                        (int)player.ReadyWeapon,
                        BuildOwnedWeaponMask( player ),
                        player.Ammo[(int)ManagedDoom.AmmoType.Clip],
                        player.Ammo[(int)ManagedDoom.AmmoType.Shell],
                        player.Ammo[(int)ManagedDoom.AmmoType.Cell],
                        player.Ammo[(int)ManagedDoom.AmmoType.Missile] );
                }
            }

            for ( var ammoIndex = 0; ammoIndex < (int)ManagedDoom.AmmoType.Count; ammoIndex++ )
            {
                var ammoNow = player.Ammo[ammoIndex];
                var ammoBefore = _lastPublishedAmmo[playerIndex, ammoIndex];
                if ( ammoNow > ammoBefore )
                {
                    session.QueueWeaponEvent(
                        playerIndex,
                        SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.PickupAmmo,
                        -1,
                        ammoIndex,
                        ammoNow - ammoBefore,
                        (int)player.ReadyWeapon,
                        BuildOwnedWeaponMask( player ),
                        player.Ammo[(int)ManagedDoom.AmmoType.Clip],
                        player.Ammo[(int)ManagedDoom.AmmoType.Shell],
                        player.Ammo[(int)ManagedDoom.AmmoType.Cell],
                        player.Ammo[(int)ManagedDoom.AmmoType.Missile] );
                }
            }

            if ( _lastPublishedReadyWeapon[playerIndex] != player.ReadyWeapon )
            {
                session.QueueWeaponEvent(
                    playerIndex,
                    SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.SwitchWeapon,
                    (int)player.ReadyWeapon,
                    -1,
                    0,
                    (int)player.ReadyWeapon,
                    BuildOwnedWeaponMask( player ),
                    player.Ammo[(int)ManagedDoom.AmmoType.Clip],
                    player.Ammo[(int)ManagedDoom.AmmoType.Shell],
                    player.Ammo[(int)ManagedDoom.AmmoType.Cell],
                    player.Ammo[(int)ManagedDoom.AmmoType.Missile] );
            }

            CaptureWeaponEventSnapshot( playerIndex, player );
        }
    }

    private void CaptureWeaponEventSnapshot( int playerIndex, ManagedDoom.Player player )
    {
        _weaponEventSnapshotInitialized[playerIndex] = true;
        _lastPublishedReadyWeapon[playerIndex] = player.ReadyWeapon;
        _lastPublishedWeaponPlayerState[playerIndex] = player.PlayerState;

        for ( var weaponIndex = 0; weaponIndex < (int)ManagedDoom.WeaponType.Count; weaponIndex++ )
        {
            _lastPublishedWeaponOwned[playerIndex, weaponIndex] = player.WeaponOwned[weaponIndex];
        }

        for ( var ammoIndex = 0; ammoIndex < (int)ManagedDoom.AmmoType.Count; ammoIndex++ )
        {
            _lastPublishedAmmo[playerIndex, ammoIndex] = player.Ammo[ammoIndex];
        }
    }

    private void PublishAuthoritativePickupPresentationEvents( SboxManagedDoomMultiplayerSessionComponent session, ManagedDoom.Player[] players )
    {
        for ( var playerIndex = 0; playerIndex < 2 && playerIndex < players.Length; playerIndex++ )
        {
            var player = players[playerIndex];
            if ( player is null )
            {
                continue;
            }

            if ( !_pickupPresentationSnapshotInitialized[playerIndex] )
            {
                CapturePickupPresentationSnapshot( playerIndex, player );
                continue;
            }

            var gainedHealth = player.Health > _lastPublishedPresentationHealth[playerIndex];
            var gainedArmor = player.ArmorPoints > _lastPublishedPresentationArmor[playerIndex];
            var gainedBonus = player.BonusCount > _lastPublishedPresentationBonusCount[playerIndex];

            if ( gainedBonus && (gainedHealth || gainedArmor) )
            {
                session.QueueEffectEvent(
                    SboxManagedDoomMultiplayerSessionComponent.MultiplayerEffectEventType.PlayLocalSfx,
                    playerIndex,
                    (int)ManagedDoom.Sfx.ITEMUP );
            }

            CapturePickupPresentationSnapshot( playerIndex, player );
        }
    }

    private void CapturePickupPresentationSnapshot( int playerIndex, ManagedDoom.Player player )
    {
        _pickupPresentationSnapshotInitialized[playerIndex] = true;
        _lastPublishedPresentationHealth[playerIndex] = player.Health;
        _lastPublishedPresentationArmor[playerIndex] = player.ArmorPoints;
        _lastPublishedPresentationBonusCount[playerIndex] = player.BonusCount;
    }

    private void CaptureCombatEventSnapshot( int playerIndex, ManagedDoom.Player player )
    {
        _combatEventSnapshotInitialized[playerIndex] = true;
        _lastPublishedCombatHealth[playerIndex] = player.Mobj?.Health ?? player.Health;
        _lastPublishedCombatDamageCount[playerIndex] = player.DamageCount;
        _lastPublishedCombatPlayerState[playerIndex] = player.PlayerState;

        for ( var fragIndex = 0; fragIndex < ManagedDoom.Player.MaxPlayerCount; fragIndex++ )
        {
            _lastPublishedCombatFrags[playerIndex, fragIndex] = player.Frags[fragIndex];
        }
    }

    private void QueueCombatSnapshot(
        SboxManagedDoomMultiplayerSessionComponent session,
        int playerIndex,
        SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType eventType,
        ManagedDoom.Player player )
    {
        session.QueueCombatEvent(
            playerIndex,
            eventType,
            player.Mobj?.Health ?? player.Health,
            player.DamageCount,
            (int)player.PlayerState,
            (int)player.ReadyWeapon,
            BuildOwnedWeaponMask( player ),
            player.Ammo[(int)ManagedDoom.AmmoType.Clip],
            player.Ammo[(int)ManagedDoom.AmmoType.Shell],
            player.Ammo[(int)ManagedDoom.AmmoType.Cell],
            player.Ammo[(int)ManagedDoom.AmmoType.Missile],
            player.Frags[0],
            player.Frags[1],
            player.Frags[2],
            player.Frags[3] );
    }

    private static int BuildOwnedWeaponMask( ManagedDoom.Player player )
    {
        var mask = 0;
        for ( var weaponIndex = 0; weaponIndex < (int)ManagedDoom.WeaponType.Count; weaponIndex++ )
        {
            if ( player.WeaponOwned[weaponIndex] )
            {
                mask |= 1 << weaponIndex;
            }
        }

        return mask;
    }

    private void PumpSharedSimulationPvpChecksum( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( session is null || _doom?.Game?.World is null )
        {
            return;
        }

        var levelTime = _doom.Game.World.LevelTime;
        var localPlayerIndex = Networking.IsHost ? 0 : 1;
        var localChecksum = BuildSharedSimulationPvpChecksum();
        session.SetPvpChecksumRpc( localPlayerIndex, levelTime, localChecksum );

        if ( string.IsNullOrEmpty( session.Player0PvpChecksum )
            || string.IsNullOrEmpty( session.Player1PvpChecksum )
            || session.Player0PvpChecksumLevelTime != session.Player1PvpChecksumLevelTime )
        {
            return;
        }

        var mismatchSignature = string.Format(
            "{0}:{1}:{2}",
            session.Player0PvpChecksumLevelTime,
            session.Player0PvpChecksum,
            session.Player1PvpChecksum );

        if ( session.Player0PvpChecksum != session.Player1PvpChecksum )
        {
            if ( mismatchSignature != _lastReportedPvpChecksumMismatchSignature )
            {
                _lastReportedPvpChecksumMismatchSignature = mismatchSignature;
                Log.Warning(
                    $"[MP-PVP] Shared-sim checksum mismatch at levelTime={session.Player0PvpChecksumLevelTime}. "
                    + $"host={session.Player0PvpChecksum} joiner={session.Player1PvpChecksum}" );
                LogSharedSimulationMismatchDetails( session.Player0PvpChecksumLevelTime );
            }

            return;
        }

        _lastReportedPvpChecksumMismatchSignature = string.Empty;
    }

    private void LogSharedSimulationMismatchDetails( int levelTime )
    {
        if ( _doom?.Options?.Players is null || _doom?.Game?.World is null )
        {
            return;
        }

        if ( levelTime == _lastLoggedSharedSimulationMismatchLevelTime )
        {
            return;
        }

        _lastLoggedSharedSimulationMismatchLevelTime = levelTime;

        for ( var playerIndex = 0; playerIndex < 2 && playerIndex < _doom.Options.Players.Length; playerIndex++ )
        {
            var player = _doom.Options.Players[playerIndex];
            if ( player is null )
            {
                Log.Warning( $"[MP-PVP] mismatch detail slot={playerIndex} host={Networking.IsHost} levelTime={levelTime} player=null" );
                continue;
            }

            var mobj = player.Mobj;
            Log.Warning(
                $"[MP-PVP] mismatch detail slot={playerIndex} host={Networking.IsHost} levelTime={levelTime} "
                + $"state={player.PlayerState} health={player.Health} damage={player.DamageCount} armor={player.ArmorPoints} "
                + $"ready={player.ReadyWeapon} pending={player.PendingWeapon} "
                + $"ammo={player.Ammo[0]},{player.Ammo[1]},{player.Ammo[2]},{player.Ammo[3]} "
                + $"frags={player.Frags[0]},{player.Frags[1]},{player.Frags[2]},{player.Frags[3]} "
                + $"mobj={( mobj is null ? "null" : mobj.GetHashCode().ToString() )} "
                + $"pos={( mobj is null ? "null" : $"{mobj.X.Data},{mobj.Y.Data},{mobj.Z.Data}" )} "
                + $"mom={( mobj is null ? "null" : $"{mobj.MomX.Data},{mobj.MomY.Data},{mobj.MomZ.Data}" )} "
                + $"angle={( mobj is null ? "null" : unchecked( (int)mobj.Angle.Data ).ToString() )}" );
        }
    }

    private string BuildSharedSimulationPvpChecksum()
    {
        if ( _doom?.Game?.World is null )
        {
            return string.Empty;
        }

        EnsurePvpPickupTrackingInitialized();

        var world = _doom.Game.World;
        var players = _doom.Options.Players;
        uint hash = 2166136261u;

        AddChecksumInt( ref hash, world.LevelTime );

        for ( var playerIndex = 0; playerIndex < 2; playerIndex++ )
        {
            var player = players[playerIndex];
            AddChecksumBool( ref hash, player?.InGame == true );

            if ( player is null )
            {
                continue;
            }

            AddChecksumInt( ref hash, (int)player.PlayerState );
            AddChecksumInt( ref hash, player.Health );
            AddChecksumInt( ref hash, player.DamageCount );
            AddChecksumInt( ref hash, player.ArmorPoints );
            AddChecksumInt( ref hash, (int)player.ReadyWeapon );
            AddChecksumInt( ref hash, (int)player.PendingWeapon );
            AddChecksumInt( ref hash, BuildOwnedWeaponMask( player ) );

            for ( var ammoIndex = 0; ammoIndex < (int)ManagedDoom.AmmoType.Count; ammoIndex++ )
            {
                AddChecksumInt( ref hash, player.Ammo[ammoIndex] );
                AddChecksumInt( ref hash, player.MaxAmmo[ammoIndex] );
            }

            for ( var fragIndex = 0; fragIndex < ManagedDoom.Player.MaxPlayerCount; fragIndex++ )
            {
                AddChecksumInt( ref hash, player.Frags[fragIndex] );
            }

            if ( player.Mobj is not null )
            {
                AddChecksumInt( ref hash, player.Mobj.X.Data );
                AddChecksumInt( ref hash, player.Mobj.Y.Data );
                AddChecksumInt( ref hash, player.Mobj.Z.Data );
                AddChecksumInt( ref hash, player.Mobj.MomX.Data );
                AddChecksumInt( ref hash, player.Mobj.MomY.Data );
                AddChecksumInt( ref hash, player.Mobj.MomZ.Data );
                AddChecksumInt( ref hash, unchecked( (int)player.Mobj.Angle.Data ) );
                AddChecksumInt( ref hash, player.Mobj.Health );
            }
        }

        foreach ( var thinker in world.Thinkers )
        {
            if ( thinker is not ManagedDoom.Mobj mobj || mobj.ThinkerState == ManagedDoom.ThinkerState.Removed )
            {
                continue;
            }

            if ( IsAuthoritativePvpProjectile( mobj ) )
            {
                AddChecksumInt( ref hash, 1000 );
                AddChecksumInt( ref hash, (int)mobj.Type );
                AddChecksumInt( ref hash, ResolveProjectileOwnerIndex( mobj.Target ) );
                AddChecksumInt( ref hash, mobj.X.Data );
                AddChecksumInt( ref hash, mobj.Y.Data );
                AddChecksumInt( ref hash, mobj.Z.Data );
                AddChecksumInt( ref hash, mobj.MomX.Data );
                AddChecksumInt( ref hash, mobj.MomY.Data );
                AddChecksumInt( ref hash, mobj.MomZ.Data );
                AddChecksumInt( ref hash, unchecked( (int)mobj.Angle.Data ) );
                AddChecksumInt( ref hash, mobj.Tics );
                continue;
            }

            if ( mobj.Type == ManagedDoom.MobjType.Barrel
                && mobj.SpawnPoint is not null
                && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var barrelThingIndex ) )
            {
                AddChecksumInt( ref hash, 2000 );
                AddChecksumInt( ref hash, barrelThingIndex );
                AddChecksumInt( ref hash, mobj.Health );
                AddChecksumInt( ref hash, mobj.X.Data );
                AddChecksumInt( ref hash, mobj.Y.Data );
                AddChecksumInt( ref hash, mobj.Z.Data );
                continue;
            }

            if ( mobj.SpawnPoint is not null
                && ( mobj.Flags & ManagedDoom.MobjFlags.Special ) != 0
                && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var pickupThingIndex ) )
            {
                AddChecksumInt( ref hash, 3000 );
                AddChecksumInt( ref hash, pickupThingIndex );
                AddChecksumInt( ref hash, (int)mobj.Type );
                AddChecksumInt( ref hash, mobj.X.Data );
                AddChecksumInt( ref hash, mobj.Y.Data );
                AddChecksumInt( ref hash, mobj.Z.Data );
            }
        }

        return hash.ToString( "x8" );
    }

    private static void AddChecksumBool( ref uint hash, bool value )
    {
        AddChecksumInt( ref hash, value ? 1 : 0 );
    }

    private static void AddChecksumInt( ref uint hash, int value )
    {
        unchecked
        {
            var raw = (uint)value;
            hash ^= raw & 0xff;
            hash *= 16777619u;
            hash ^= (raw >> 8) & 0xff;
            hash *= 16777619u;
            hash ^= (raw >> 16) & 0xff;
            hash *= 16777619u;
            hash ^= (raw >> 24) & 0xff;
            hash *= 16777619u;
        }
    }

    private void ApplyAuthoritativePvpState( SboxManagedDoomMultiplayerSessionComponent session )
    {
        CaptureLocalPlayerPresentationSnapshots();

        for ( var playerIndex = 0; playerIndex < 2; playerIndex++ )
        {
            ApplyAuthoritativePlayerState( session, playerIndex );
        }

        RestoreLocalPlayerPresentationSnapshots();
        ConsumeAuthoritativeCombatEvents( session );
        ConsumeAuthoritativeWeaponEvents( session );
        ConsumeAuthoritativeEffectEvents( session );
        ApplyPendingLocalWeaponTargets();
        TickWeaponRespawnSettleWindows();
    }

    private void ApplyAuthoritativePvpProjectileState( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( Networking.IsHost || _doom?.Game?.World is null )
        {
            return;
        }

        var projectileState = session.PvpProjectileState ?? string.Empty;
        if ( string.Equals( projectileState, _lastAppliedPvpProjectileState, StringComparison.Ordinal ) )
        {
            return;
        }

        _lastAppliedPvpProjectileState = projectileState;

        var world = _doom.Game.World;
        var localProjectiles = new List<ManagedDoom.Mobj>();
        foreach ( var thinker in world.Thinkers )
        {
            if ( thinker is ManagedDoom.Mobj projectile && IsAuthoritativePvpProjectile( projectile ) )
            {
                localProjectiles.Add( projectile );
            }
        }

        var matchedLocalProjectiles = new bool[localProjectiles.Count];
        var snapshots = ParseProjectileSnapshots( projectileState );

        for ( var snapshotIndex = 0; snapshotIndex < snapshots.Count; snapshotIndex++ )
        {
            var snapshot = snapshots[snapshotIndex];
            var localIndex = FindBestMatchingProjectileIndex( localProjectiles, matchedLocalProjectiles, snapshot );

            ManagedDoom.Mobj projectile;
            if ( localIndex >= 0 )
            {
                matchedLocalProjectiles[localIndex] = true;
                projectile = localProjectiles[localIndex];
            }
            else
            {
                projectile = world.ThingAllocation.SpawnMobj(
                    new ManagedDoom.Fixed( snapshot.X ),
                    new ManagedDoom.Fixed( snapshot.Y ),
                    new ManagedDoom.Fixed( snapshot.Z ),
                    snapshot.Type );
            }

            ApplyProjectileSnapshot( world, projectile, snapshot );
        }

        for ( var i = 0; i < localProjectiles.Count; i++ )
        {
            if ( !matchedLocalProjectiles[i] )
            {
                world.ThingAllocation.RemoveMobj( localProjectiles[i] );
            }
        }
    }

    private void CaptureLocalPlayerPresentationSnapshots()
    {
        if ( Networking.IsHost || _doom?.Options?.Players is null )
        {
            return;
        }

        var localPlayerIndex = _doom.Options.ConsolePlayer;
        if ( localPlayerIndex < 0 || localPlayerIndex >= _doom.Options.Players.Length )
        {
            return;
        }

        var player = _doom.Options.Players[localPlayerIndex];
        if ( player is null )
        {
            return;
        }

        _localPlayerPresentationSnapshots[localPlayerIndex].Capture( player );
    }

    private void RestoreLocalPlayerPresentationSnapshots()
    {
        if ( Networking.IsHost || _doom?.Options?.Players is null )
        {
            return;
        }

        var localPlayerIndex = _doom.Options.ConsolePlayer;
        if ( localPlayerIndex < 0 || localPlayerIndex >= _doom.Options.Players.Length )
        {
            return;
        }

        var player = _doom.Options.Players[localPlayerIndex];
        if ( player is null || player.PlayerState != ManagedDoom.PlayerState.Live )
        {
            return;
        }

        _localPlayerPresentationSnapshots[localPlayerIndex].Restore( player );
        player.DisableFrameInterpolationForOneFrame();
    }

    private void ConsumeAuthoritativeCombatEvents( SboxManagedDoomMultiplayerSessionComponent session )
    {
        for ( var playerIndex = 0; playerIndex < 2; playerIndex++ )
        {
            var queue = playerIndex == 0 ? session.Player0CombatEventQueue : session.Player1CombatEventQueue;
            if ( string.IsNullOrWhiteSpace( queue ) )
            {
                continue;
            }

            var entries = queue.Split( '|', StringSplitOptions.RemoveEmptyEntries );
            for ( var i = 0; i < entries.Length; i++ )
            {
                var parts = entries[i].Split( ',', StringSplitOptions.None );
                if ( parts.Length < 15 || !int.TryParse( parts[0], out var serial ) )
                {
                    continue;
                }

                if ( serial <= _lastConsumedCombatEventSerial[playerIndex] )
                {
                    continue;
                }

                _lastConsumedCombatEventSerial[playerIndex] = serial;

                if ( Networking.IsHost )
                {
                    continue;
                }

                if ( !int.TryParse( parts[1], out var eventTypeValue ) )
                {
                    continue;
                }

                ConsumeAuthoritativeCombatEvent(
                    playerIndex,
                    (SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType)eventTypeValue,
                    ParseIntOrDefault( parts[2], 0 ),
                    ParseIntOrDefault( parts[3], 0 ),
                    ParseIntOrDefault( parts[4], (int)ManagedDoom.PlayerState.Live ),
                    ParseIntOrDefault( parts[5], -1 ),
                    ParseIntOrDefault( parts[6], 0 ),
                    ParseIntOrDefault( parts[7], 0 ),
                    ParseIntOrDefault( parts[8], 0 ),
                    ParseIntOrDefault( parts[9], 0 ),
                    ParseIntOrDefault( parts[10], 0 ),
                    ParseIntOrDefault( parts[11], 0 ),
                    ParseIntOrDefault( parts[12], 0 ),
                    ParseIntOrDefault( parts[13], 0 ),
                    ParseIntOrDefault( parts[14], 0 ) );
            }
        }
    }

    private void ConsumeAuthoritativePvpHitscanEvents( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( Networking.IsHost || _doom?.Game?.World?.Hitscan is null )
        {
            return;
        }

        var queue = session.HitscanEventQueue ?? string.Empty;
        if ( string.IsNullOrWhiteSpace( queue ) )
        {
            return;
        }

        var entries = queue.Split( '|', StringSplitOptions.RemoveEmptyEntries );
        for ( var i = 0; i < entries.Length; i++ )
        {
            var parts = entries[i].Split( ',', StringSplitOptions.None );
            if ( parts.Length < 6
                || !int.TryParse( parts[0], out var serial )
                || serial <= _lastConsumedHitscanEventSerial )
            {
                continue;
            }

            _lastConsumedHitscanEventSerial = serial;

            var blood = ParseIntOrDefault( parts[1], 0 ) != 0;
            var x = ParseIntOrDefault( parts[2], 0 );
            var y = ParseIntOrDefault( parts[3], 0 );
            var z = ParseIntOrDefault( parts[4], 0 );
            var damage = ParseIntOrDefault( parts[5], 0 );

            if ( WasPredictedLocalHitscanRecently( blood, x, y, z ) )
            {
                continue;
            }

            if ( blood )
            {
                _doom.Game.World.Hitscan.SpawnBlood(
                    new ManagedDoom.Fixed( x ),
                    new ManagedDoom.Fixed( y ),
                    new ManagedDoom.Fixed( z ),
                    damage );
            }
            else
            {
                _doom.Game.World.Hitscan.SpawnPuff(
                    new ManagedDoom.Fixed( x ),
                    new ManagedDoom.Fixed( y ),
                    new ManagedDoom.Fixed( z ) );
            }
        }
    }

    private void ConsumeAuthoritativeCombatEvent(
        int playerIndex,
        SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType eventType,
        int health,
        int damageCount,
        int playerStateValue,
        int selectedWeaponValue,
        int ownedWeaponMask,
        int ammoClip,
        int ammoShell,
        int ammoCell,
        int ammoMissile,
        int frag0,
        int frag1,
        int frag2,
        int frag3 )
    {
        if ( _doom?.Options?.Players is null || playerIndex < 0 || playerIndex >= _doom.Options.Players.Length )
        {
            return;
        }

        var player = _doom.Options.Players[playerIndex];
        if ( player?.Mobj is null )
        {
            return;
        }

        var isJoinerLocalPlayer = !Networking.IsHost && playerIndex == _doom.Options.ConsolePlayer;

        player.Mobj.Health = health;
        player.Health = health;
        player.DamageCount = damageCount;
        player.Frags[0] = frag0;
        player.Frags[1] = frag1;
        player.Frags[2] = frag2;
        player.Frags[3] = frag3;

        if ( !isJoinerLocalPlayer )
        {
            player.PlayerState = (ManagedDoom.PlayerState)playerStateValue;
        }

        switch ( eventType )
        {
            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType.Damage:
                if ( isJoinerLocalPlayer && health > 0 )
                {
                    PlayConfirmedLocalPainFeedback();
                }
                break;

            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType.Death:
                player.PlayerState = ManagedDoom.PlayerState.Dead;
                player.DamageCount = Math.Max( player.DamageCount, 20 );
                _pendingLocalWeaponTargets[playerIndex] = null;
                if ( isJoinerLocalPlayer )
                {
                    ClearLocalPickupPredictionState();
                }
                break;

            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerCombatEventType.Respawn:
                player.PlayerState = ManagedDoom.PlayerState.Live;
                if ( isJoinerLocalPlayer )
                {
                    ApplyRespawnLoadoutEvent( playerIndex, player, selectedWeaponValue, ownedWeaponMask, ammoClip, ammoShell, ammoCell, ammoMissile );
                }
                else
                {
                    ApplyOwnedWeaponMask( player, ownedWeaponMask );
                    ApplyAmmoSnapshot( player, ammoClip, ammoShell, ammoCell, ammoMissile );
                }
                break;
        }
    }

    private void ConsumeAuthoritativeWeaponEvents( SboxManagedDoomMultiplayerSessionComponent session )
    {
        for ( var playerIndex = 0; playerIndex < 2; playerIndex++ )
        {
            var queue = playerIndex == 0 ? session.Player0WeaponEventQueue : session.Player1WeaponEventQueue;
            if ( string.IsNullOrWhiteSpace( queue ) )
            {
                continue;
            }

            var entries = queue.Split( '|', StringSplitOptions.RemoveEmptyEntries );
            for ( var i = 0; i < entries.Length; i++ )
            {
                var parts = entries[i].Split( ',', StringSplitOptions.None );
                if ( parts.Length < 11 || !int.TryParse( parts[0], out var serial ) )
                {
                    continue;
                }

                if ( serial <= _lastConsumedWeaponEventSerial[playerIndex] )
                {
                    continue;
                }

                _lastConsumedWeaponEventSerial[playerIndex] = serial;

                if ( Networking.IsHost )
                {
                    continue;
                }

                if ( !int.TryParse( parts[1], out var eventTypeValue ) )
                {
                    continue;
                }

                var eventType = (SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType)eventTypeValue;
                var weapon = ParseIntOrDefault( parts[2], -1 );
                var ammoType = ParseIntOrDefault( parts[3], -1 );
                var ammoAmount = ParseIntOrDefault( parts[4], 0 );
                var selectedWeapon = ParseIntOrDefault( parts[5], -1 );
                var ownedWeaponMask = ParseIntOrDefault( parts[6], 0 );
                var ammoClip = ParseIntOrDefault( parts[7], 0 );
                var ammoShell = ParseIntOrDefault( parts[8], 0 );
                var ammoCell = ParseIntOrDefault( parts[9], 0 );
                var ammoMissile = ParseIntOrDefault( parts[10], 0 );

                ConsumeAuthoritativeWeaponEvent(
                    playerIndex,
                    eventType,
                    weapon,
                    ammoType,
                    ammoAmount,
                    selectedWeapon,
                    ownedWeaponMask,
                    ammoClip,
                    ammoShell,
                    ammoCell,
                    ammoMissile );
            }
        }
    }

    private void ConsumeAuthoritativeWeaponEvent(
        int playerIndex,
        SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType eventType,
        int weaponValue,
        int ammoTypeValue,
        int ammoAmount,
        int selectedWeaponValue,
        int ownedWeaponMask,
        int ammoClip,
        int ammoShell,
        int ammoCell,
        int ammoMissile )
    {
        if ( _doom?.Options?.Players is null || playerIndex < 0 || playerIndex >= _doom.Options.Players.Length )
        {
            return;
        }

        var player = _doom.Options.Players[playerIndex];
        if ( player is null )
        {
            return;
        }

        var isJoinerLocalPlayer = !Networking.IsHost && playerIndex == _doom.Options.ConsolePlayer;

        ApplyOwnedWeaponMask( player, ownedWeaponMask );
        ApplyAmmoSnapshot( player, ammoClip, ammoShell, ammoCell, ammoMissile );

        switch ( eventType )
        {
            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.PickupWeapon:
                if ( isJoinerLocalPlayer )
                {
                    SuppressReplicatedItemPickupSfxForWeaponWindow();

                    if ( IsValidWeaponValue( weaponValue ) )
                    {
                        _pendingLocalWeaponTargets[playerIndex] = (ManagedDoom.WeaponType)weaponValue;
                    }

                    TryPlayReplicatedSfx( ManagedDoom.Sfx.WPNUP );
                }
                break;

            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.PickupAmmo:
                if ( IsValidAmmoTypeValue( ammoTypeValue ) && ammoAmount > 0 )
                {
                    if ( isJoinerLocalPlayer )
                    {
                        if ( DateTime.UtcNow < _suppressReplicatedItemPickupSfxUntilUtc )
                        {
                            break;
                        }

                        TryPlayReplicatedSfx( ManagedDoom.Sfx.ITEMUP );
                    }
                }
                break;

            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.SwitchWeapon:
                if ( isJoinerLocalPlayer && IsValidWeaponValue( selectedWeaponValue ) )
                {
                    _pendingLocalWeaponTargets[playerIndex] = (ManagedDoom.WeaponType)selectedWeaponValue;
                }
                break;

            case SboxManagedDoomMultiplayerSessionComponent.MultiplayerWeaponEventType.RespawnLoadout:
                if ( isJoinerLocalPlayer )
                {
                    ApplyRespawnLoadoutEvent( playerIndex, player, selectedWeaponValue, ownedWeaponMask, ammoClip, ammoShell, ammoCell, ammoMissile );
                }
                break;
        }
    }

    private void ConsumeAuthoritativeEffectEvents( SboxManagedDoomMultiplayerSessionComponent session )
    {
        if ( Networking.IsHost || _doom?.Options is null )
        {
            return;
        }

        var queue = session.EffectEventQueue ?? string.Empty;
        if ( string.IsNullOrWhiteSpace( queue ) )
        {
            return;
        }

        var entries = queue.Split( '|', StringSplitOptions.RemoveEmptyEntries );
        for ( var i = 0; i < entries.Length; i++ )
        {
            var parts = entries[i].Split( ',', StringSplitOptions.None );
            if ( parts.Length < 4
                || !int.TryParse( parts[0], out var serial )
                || serial <= _lastConsumedEffectEventSerial )
            {
                continue;
            }

            _lastConsumedEffectEventSerial = serial;

            var eventType = (SboxManagedDoomMultiplayerSessionComponent.MultiplayerEffectEventType)ParseIntOrDefault( parts[1], 0 );
            var playerIndex = ParseIntOrDefault( parts[2], -1 );
            var value = ParseIntOrDefault( parts[3], -1 );

            if ( eventType == SboxManagedDoomMultiplayerSessionComponent.MultiplayerEffectEventType.PlayLocalSfx
                && playerIndex == _doom.Options.ConsolePlayer
                && Enum.IsDefined( typeof( ManagedDoom.Sfx ), value ) )
            {
                TryPlayReplicatedSfx( (ManagedDoom.Sfx)value );
            }
            else if ( eventType == SboxManagedDoomMultiplayerSessionComponent.MultiplayerEffectEventType.BarrelExploded )
            {
                PlayAuthoritativeBarrelExplosionByIndex( playerIndex );
            }
        }
    }

    private void ApplyPendingLocalWeaponTargets()
    {
        if ( _doom?.Options?.Players is null )
        {
            return;
        }

        if ( Networking.IsHost )
        {
            return;
        }

        var localPlayerIndex = _doom.Options.ConsolePlayer;
        if ( localPlayerIndex < 0 || localPlayerIndex >= _doom.Options.Players.Length )
        {
            return;
        }

        for ( var playerIndex = localPlayerIndex; playerIndex <= localPlayerIndex; playerIndex++ )
        {
            var targetWeapon = _pendingLocalWeaponTargets[playerIndex];
            if ( targetWeapon is null )
            {
                continue;
            }

            var player = _doom.Options.Players[playerIndex];
            if ( player is null || player.PlayerState != ManagedDoom.PlayerState.Live )
            {
                continue;
            }

            if ( _weaponRespawnSettleTics[playerIndex] > 0 )
            {
                continue;
            }

            if ( !player.WeaponOwned[(int)targetWeapon.Value] )
            {
                _pendingLocalWeaponTargets[playerIndex] = null;
                continue;
            }

            if ( player.ReadyWeapon == targetWeapon.Value || player.PendingWeapon == targetWeapon.Value )
            {
                _pendingLocalWeaponTargets[playerIndex] = null;
                continue;
            }

            if ( player.PendingWeapon == ManagedDoom.WeaponType.NoChange )
            {
                player.PendingWeapon = targetWeapon.Value;
            }
        }
    }

    private void TickWeaponRespawnSettleWindows()
    {
        for ( var i = 0; i < _weaponRespawnSettleTics.Length; i++ )
        {
            if ( _weaponRespawnSettleTics[i] > 0 )
            {
                _weaponRespawnSettleTics[i]--;
            }
        }
    }

    private void ApplyRespawnLoadoutEvent(
        int playerIndex,
        ManagedDoom.Player player,
        int selectedWeaponValue,
        int ownedWeaponMask,
        int ammoClip,
        int ammoShell,
        int ammoCell,
        int ammoMissile )
    {
        var selectedWeapon = ResolveSafeSelectedWeapon( player, selectedWeaponValue, ownedWeaponMask );

        player.PlayerState = ManagedDoom.PlayerState.Live;
        if ( !Networking.IsHost && playerIndex == _doom.Options.ConsolePlayer )
        {
            ClearLocalPickupPredictionState();
        }

        ApplyOwnedWeaponMask( player, ownedWeaponMask );
        ApplyAmmoSnapshot( player, ammoClip, ammoShell, ammoCell, ammoMissile );

        player.ReadyWeapon = selectedWeapon;
        player.PendingWeapon = selectedWeapon;
        player.AttackDown = true;
        player.UseDown = true;

        for ( var i = 0; i < player.PlayerSprites.Length; i++ )
        {
            player.PlayerSprites[i].State = null;
            player.PlayerSprites[i].Tics = 0;
        }

        _doom.Game?.World?.PlayerBehavior?.SetupPlayerSprites( player );
        _pendingLocalWeaponTargets[playerIndex] = null;
        _weaponRespawnSettleTics[playerIndex] = 8;
    }

    private static ManagedDoom.WeaponType ResolveSafeSelectedWeapon( ManagedDoom.Player player, int selectedWeaponValue, int ownedWeaponMask )
    {
        if ( IsValidWeaponValue( selectedWeaponValue ) && (ownedWeaponMask & (1 << selectedWeaponValue)) != 0 )
        {
            return (ManagedDoom.WeaponType)selectedWeaponValue;
        }

        if ( (ownedWeaponMask & (1 << (int)ManagedDoom.WeaponType.Pistol)) != 0 )
        {
            return ManagedDoom.WeaponType.Pistol;
        }

        if ( (ownedWeaponMask & (1 << (int)ManagedDoom.WeaponType.Fist)) != 0 )
        {
            return ManagedDoom.WeaponType.Fist;
        }

        for ( var weaponIndex = 0; weaponIndex < (int)ManagedDoom.WeaponType.Count; weaponIndex++ )
        {
            if ( (ownedWeaponMask & (1 << weaponIndex)) != 0 )
            {
                return (ManagedDoom.WeaponType)weaponIndex;
            }
        }

        return player.ReadyWeapon;
    }

    private static void ApplyAmmoSnapshot( ManagedDoom.Player player, int ammoClip, int ammoShell, int ammoCell, int ammoMissile )
    {
        player.Ammo[(int)ManagedDoom.AmmoType.Clip] = ammoClip;
        player.Ammo[(int)ManagedDoom.AmmoType.Shell] = ammoShell;
        player.Ammo[(int)ManagedDoom.AmmoType.Cell] = ammoCell;
        player.Ammo[(int)ManagedDoom.AmmoType.Missile] = ammoMissile;
    }

    private static void ApplyOwnedWeaponMask( ManagedDoom.Player player, int ownedWeaponMask )
    {
        for ( var weaponIndex = 0; weaponIndex < (int)ManagedDoom.WeaponType.Count; weaponIndex++ )
        {
            player.WeaponOwned[weaponIndex] = (ownedWeaponMask & (1 << weaponIndex)) != 0;
        }
    }

    private void OnSuppressedLocalPickupPresentation( ManagedDoom.Mobj special, ManagedDoom.Player player )
    {
        if ( player is null || _doom?.Options is null )
        {
            return;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session?.PvpActive != true || Networking.IsHost || player.Number != _doom.Options.ConsolePlayer )
        {
            return;
        }

        if ( !ShouldPredictPickupPresentation( special, player ) )
        {
            return;
        }

        ApplyPredictedPickupPresentation( special, player );
        var predictedSfx = ResolvePredictedPickupSfx( special );
        if ( predictedSfx == ManagedDoom.Sfx.WPNUP )
        {
            SuppressReplicatedItemPickupSfxForWeaponWindow();
        }

        PlayPredictedLocalSfx( predictedSfx );
    }

    private void ApplyPredictedPickupPresentation( ManagedDoom.Mobj special, ManagedDoom.Player player )
    {
        if ( player is null || special is null )
        {
            return;
        }

        if ( !TryResolvePickupWeaponType( special.Sprite, out var weaponType ) )
        {
            return;
        }

        if ( player.WeaponOwned[(int)weaponType] )
        {
            return;
        }

        player.WeaponOwned[(int)weaponType] = true;

        if ( player.PlayerState != ManagedDoom.PlayerState.Live )
        {
            return;
        }

        if ( player.PendingWeapon != ManagedDoom.WeaponType.NoChange )
        {
            return;
        }

        if ( player.ReadyWeapon == weaponType )
        {
            return;
        }

        player.PendingWeapon = weaponType;
        _pendingLocalWeaponTargets[player.Number] = weaponType;
    }

    private void PlayConfirmedLocalPainFeedback()
    {
        _sound?.StartSound( ManagedDoom.Sfx.PLPAIN );
    }

    private void ClearLocalPickupPredictionState()
    {
        _predictedPickupThingTimes.Clear();
        _pendingLocalWeaponTargets[_doom.Options.ConsolePlayer] = null;
        _suppressReplicatedItemPickupSfxUntilUtc = DateTime.MinValue;
    }

    private void SuppressReplicatedItemPickupSfxForWeaponWindow()
    {
        _suppressReplicatedItemPickupSfxUntilUtc = DateTime.UtcNow.AddMilliseconds( 350.0 );
    }

    private void OnSuppressedLocalDamagePresentation( ManagedDoom.Mobj target, int damage )
    {
        if ( target is null || damage <= 0 )
        {
            return;
        }

        var session = _multiplayerSession ?? SboxManagedDoomMultiplayerSessionComponent.Current;
        if ( session?.PvpActive != true || Networking.IsHost )
        {
            return;
        }

        if ( target.Type != ManagedDoom.MobjType.Barrel || target.Health > damage )
        {
            return;
        }

        if ( target.SpawnPoint is not null
            && _pvpMapThingIndexes.TryGetValue( target.SpawnPoint, out var mapThingIndex ) )
        {
            if ( _predictedBarrelExplosionTimes.ContainsKey( mapThingIndex ) )
            {
                return;
            }

            if ( !ShouldPredictBarrelExplosion( mapThingIndex, target.Health, damage ) )
            {
                return;
            }
        }
        else
        {
            return;
        }

        PlayPredictedBarrelExplosion( target );
    }

    private void PlayPredictedLocalSfx( ManagedDoom.Sfx sfx )
    {
        _predictedLocalSfxTimes[sfx] = DateTime.UtcNow;
        _sound?.StartSound( sfx );
    }

    private void TryPlayReplicatedSfx( ManagedDoom.Sfx sfx )
    {
        if ( WasPredictedRecently( sfx ) )
        {
            return;
        }

        _sound?.StartSound( sfx );
    }

    private bool WasPredictedRecently( ManagedDoom.Sfx sfx )
    {
        const double predictionWindowMs = 1000.0;

        if ( !_predictedLocalSfxTimes.TryGetValue( sfx, out var predictedAt ) )
        {
            return false;
        }

        _predictedLocalSfxTimes.Remove( sfx );
        return (DateTime.UtcNow - predictedAt).TotalMilliseconds <= predictionWindowMs;
    }

    private bool TryConsumePredictedBarrelExplosion( ManagedDoom.Mobj barrel )
    {
        const double predictionWindowMs = 1000.0;

        if ( barrel?.SpawnPoint is null || !_pvpMapThingIndexes.TryGetValue( barrel.SpawnPoint, out var mapThingIndex ) )
        {
            return false;
        }

        if ( !_predictedBarrelExplosionTimes.TryGetValue( mapThingIndex, out var predictedAt ) )
        {
            return false;
        }

        _predictedBarrelExplosionTimes.Remove( mapThingIndex );
        return (DateTime.UtcNow - predictedAt).TotalMilliseconds <= predictionWindowMs;
    }

    private ManagedDoom.Sfx ResolvePredictedPickupSfx( ManagedDoom.Mobj special )
    {
        if ( special is null )
        {
            return ManagedDoom.Sfx.ITEMUP;
        }

        return special.Sprite switch
        {
            ManagedDoom.Sprite.BFUG => ManagedDoom.Sfx.WPNUP,
            ManagedDoom.Sprite.CSAW => ManagedDoom.Sfx.WPNUP,
            ManagedDoom.Sprite.LAUN => ManagedDoom.Sfx.WPNUP,
            ManagedDoom.Sprite.MGUN => ManagedDoom.Sfx.WPNUP,
            ManagedDoom.Sprite.PLAS => ManagedDoom.Sfx.WPNUP,
            ManagedDoom.Sprite.SHOT => ManagedDoom.Sfx.WPNUP,
            ManagedDoom.Sprite.SGN2 => ManagedDoom.Sfx.WPNUP,
            _ => ManagedDoom.Sfx.ITEMUP
        };
    }

    private bool ShouldPredictPickupPresentation( ManagedDoom.Mobj special, ManagedDoom.Player player )
    {
        if ( special?.SpawnPoint is null || !_pvpMapThingIndexes.TryGetValue( special.SpawnPoint, out var mapThingIndex ) )
        {
            return true;
        }

        if ( _predictedPickupThingTimes.ContainsKey( mapThingIndex ) )
        {
            return false;
        }

        var predictedSfx = ResolvePredictedPickupSfx( special );
        if ( predictedSfx == ManagedDoom.Sfx.WPNUP && PlayerAlreadyOwnsPickupWeapon( player, special ) )
        {
            return false;
        }

        _predictedPickupThingTimes[mapThingIndex] = DateTime.UtcNow;
        return true;
    }

    private bool ShouldPredictBarrelExplosion( int mapThingIndex, int barrelHealth, int damage )
    {
        const double barrelDamageWindowMs = 250.0;
        var now = DateTime.UtcNow;

        if ( !_predictedBarrelDamageTimes.TryGetValue( mapThingIndex, out var lastDamageAt )
            || ( now - lastDamageAt ).TotalMilliseconds > barrelDamageWindowMs )
        {
            _predictedBarrelDamageTotals[mapThingIndex] = 0;
        }

        _predictedBarrelDamageTimes[mapThingIndex] = now;
        _predictedBarrelDamageTotals[mapThingIndex] =
            _predictedBarrelDamageTotals.GetValueOrDefault( mapThingIndex ) + Math.Max( 0, damage );

        if ( _predictedBarrelDamageTotals[mapThingIndex] < barrelHealth )
        {
            return false;
        }

        _predictedBarrelDamageTotals.Remove( mapThingIndex );
        _predictedBarrelDamageTimes.Remove( mapThingIndex );
        _predictedBarrelExplosionTimes[mapThingIndex] = now;
        return true;
    }

    private static bool PlayerAlreadyOwnsPickupWeapon( ManagedDoom.Player player, ManagedDoom.Mobj special )
    {
        if ( player is null || special is null )
        {
            return false;
        }

        if ( !TryResolvePickupWeaponType( special.Sprite, out var weaponType ) )
        {
            return false;
        }

        return player.WeaponOwned[(int)weaponType];
    }

    private static bool TryResolvePickupWeaponType( ManagedDoom.Sprite sprite, out ManagedDoom.WeaponType weaponType )
    {
        switch ( sprite )
        {
            case ManagedDoom.Sprite.BFUG:
                weaponType = ManagedDoom.WeaponType.Bfg;
                return true;
            case ManagedDoom.Sprite.CSAW:
                weaponType = ManagedDoom.WeaponType.Chainsaw;
                return true;
            case ManagedDoom.Sprite.LAUN:
                weaponType = ManagedDoom.WeaponType.Missile;
                return true;
            case ManagedDoom.Sprite.MGUN:
                weaponType = ManagedDoom.WeaponType.Chaingun;
                return true;
            case ManagedDoom.Sprite.PLAS:
                weaponType = ManagedDoom.WeaponType.Plasma;
                return true;
            case ManagedDoom.Sprite.SHOT:
                weaponType = ManagedDoom.WeaponType.Shotgun;
                return true;
            case ManagedDoom.Sprite.SGN2:
                weaponType = ManagedDoom.WeaponType.SuperShotgun;
                return true;
            default:
                weaponType = ManagedDoom.WeaponType.Fist;
                return false;
        }
    }

    private void SpawnTransientExplosionEffect( ManagedDoom.Fixed x, ManagedDoom.Fixed y, ManagedDoom.Fixed z, ManagedDoom.Sfx sfx )
    {
        if ( _doom?.Game?.World is null )
        {
            return;
        }

        var world = _doom.Game.World;
        var effect = world.ThingAllocation.SpawnMobj( x, y, z, ManagedDoom.MobjType.Barrel );
        var explosionState = ManagedDoom.DoomInfo.States[(int)ManagedDoom.MobjState.Bexp4];

        effect.Sprite = explosionState.Sprite;
        effect.Frame = explosionState.Frame;
        effect.State = explosionState;
        effect.Tics = -1;
        effect.Health = 0;
        effect.MomX = ManagedDoom.Fixed.Zero;
        effect.MomY = ManagedDoom.Fixed.Zero;
        effect.MomZ = ManagedDoom.Fixed.Zero;
        effect.Flags &= ~(ManagedDoom.MobjFlags.Shootable
            | ManagedDoom.MobjFlags.Solid
            | ManagedDoom.MobjFlags.Special
            | ManagedDoom.MobjFlags.Missile
            | ManagedDoom.MobjFlags.CountKill);
        effect.Flags |= ManagedDoom.MobjFlags.NoGravity;

        _transientPresentationMobjs[effect] = DateTime.UtcNow.AddMilliseconds( 120.0 );
        PlayPredictedLocalSfx( sfx );
    }

    private void CleanupExpiredTransientPresentationMobjs()
    {
        CleanupTransientPresentationMobjs( force: false );
    }

    private void CleanupExpiredPredictionState()
    {
        CleanupExpiredPredictionEntries( _predictedBarrelDamageTimes, 400.0, _predictedBarrelDamageTotals );
        CleanupExpiredPredictionEntries( _predictedBarrelExplosionTimes, 1200.0 );
        CleanupExpiredLocalHitscanImpacts();
    }

    private static void CleanupExpiredPredictionEntries( Dictionary<int, DateTime> entries, double maxAgeMs, Dictionary<int, int> pairedEntries = null )
    {
        if ( entries.Count == 0 )
        {
            return;
        }

        var now = DateTime.UtcNow;
        var expiredKeys = new List<int>();
        foreach ( var pair in entries )
        {
            if ( ( now - pair.Value ).TotalMilliseconds > maxAgeMs )
            {
                expiredKeys.Add( pair.Key );
            }
        }

        for ( var i = 0; i < expiredKeys.Count; i++ )
        {
            entries.Remove( expiredKeys[i] );
            pairedEntries?.Remove( expiredKeys[i] );
        }
    }

    private void CleanupTransientPresentationMobjs( bool force )
    {
        if ( _transientPresentationMobjs.Count == 0 )
        {
            return;
        }

        if ( _doom?.Game?.World is null )
        {
            if ( force )
            {
                _transientPresentationMobjs.Clear();
            }

            return;
        }

        var now = DateTime.UtcNow;
        var expired = new List<ManagedDoom.Mobj>();

        foreach ( var pair in _transientPresentationMobjs )
        {
            if ( force
                || pair.Key is null
                || pair.Key.ThinkerState == ManagedDoom.ThinkerState.Removed
                || pair.Value <= now )
            {
                expired.Add( pair.Key );
            }
        }

        for ( var i = 0; i < expired.Count; i++ )
        {
            var effect = expired[i];
            _transientPresentationMobjs.Remove( effect );

            if ( effect is not null && effect.ThinkerState != ManagedDoom.ThinkerState.Removed )
            {
                _doom.Game.World.ThingAllocation.RemoveMobj( effect );
            }
        }
    }

    private void PlayReplicatedBarrelExplosion( ManagedDoom.Mobj barrel )
    {
        if ( barrel is null || _doom?.Game?.World is null )
        {
            return;
        }

        if ( barrel.SpawnPoint is not null
            && _pvpMapThingIndexes.TryGetValue( barrel.SpawnPoint, out var mapThingIndex ) )
        {
            _predictedBarrelDamageTotals.Remove( mapThingIndex );
            _predictedBarrelDamageTimes.Remove( mapThingIndex );
        }

        var predictedRecently = TryConsumePredictedBarrelExplosion( barrel );
        if ( !predictedRecently )
        {
            SpawnTransientExplosionEffect( barrel.X, barrel.Y, barrel.Z, ManagedDoom.Sfx.BAREXP );
        }

        _doom.Game.World.ThingAllocation.RemoveMobj( barrel );
    }

    private void PlayAuthoritativeBarrelExplosionByIndex( int mapThingIndex )
    {
        if ( mapThingIndex < 0 || _doom?.Game?.World is null )
        {
            return;
        }

        _predictedBarrelDamageTotals.Remove( mapThingIndex );
        _predictedBarrelDamageTimes.Remove( mapThingIndex );

        ManagedDoom.Mobj barrel = null;
        foreach ( var thinker in _doom.Game.World.Thinkers )
        {
            if ( thinker is ManagedDoom.Mobj mobj
                && mobj.Type == ManagedDoom.MobjType.Barrel
                && mobj.SpawnPoint is not null
                && _pvpMapThingIndexes.TryGetValue( mobj.SpawnPoint, out var candidateIndex )
                && candidateIndex == mapThingIndex )
            {
                barrel = mobj;
                break;
            }
        }

        if ( barrel is not null )
        {
            PlayReplicatedBarrelExplosion( barrel );
            return;
        }

        if ( !_predictedBarrelExplosionTimes.ContainsKey( mapThingIndex ) )
        {
            _predictedBarrelExplosionTimes[mapThingIndex] = DateTime.UtcNow;
            if ( TryGetThingOriginByIndex( mapThingIndex, out var x, out var y, out var z ) )
            {
                SpawnTransientExplosionEffect( x, y, z, ManagedDoom.Sfx.BAREXP );
            }
        }
    }

    private void PlayPredictedBarrelExplosion( ManagedDoom.Mobj barrel )
    {
        if ( barrel is null )
        {
            return;
        }

        if ( barrel.SpawnPoint is not null
            && _pvpMapThingIndexes.TryGetValue( barrel.SpawnPoint, out var mapThingIndex ) )
        {
            _predictedBarrelDamageTotals.Remove( mapThingIndex );
            _predictedBarrelDamageTimes.Remove( mapThingIndex );
            _predictedBarrelExplosionTimes[mapThingIndex] = DateTime.UtcNow;
        }

        SpawnTransientExplosionEffect( barrel.X, barrel.Y, barrel.Z, ManagedDoom.Sfx.BAREXP );
    }

    private bool TryGetThingOriginByIndex( int mapThingIndex, out ManagedDoom.Fixed x, out ManagedDoom.Fixed y, out ManagedDoom.Fixed z )
    {
        x = ManagedDoom.Fixed.Zero;
        y = ManagedDoom.Fixed.Zero;
        z = ManagedDoom.Fixed.Zero;

        if ( _doom?.Game?.World?.Map?.Things is null || mapThingIndex < 0 || mapThingIndex >= _doom.Game.World.Map.Things.Length )
        {
            return false;
        }

        var mapThing = _doom.Game.World.Map.Things[mapThingIndex];
        if ( mapThing is null )
        {
            return false;
        }

        x = mapThing.X;
        y = mapThing.Y;
        z = ManagedDoom.Fixed.Zero;
        return true;
    }

    private static HashSet<int> ParseThingIndexSet( string rawValue )
    {
        var result = new HashSet<int>();
        if ( string.IsNullOrWhiteSpace( rawValue ) )
        {
            return result;
        }

        var parts = rawValue.Split( ',', StringSplitOptions.RemoveEmptyEntries );
        for ( var i = 0; i < parts.Length; i++ )
        {
            if ( int.TryParse( parts[i], out var parsedIndex ) )
            {
                result.Add( parsedIndex );
            }
        }

        return result;
    }

    private static bool IsValidWeaponValue( int value )
    {
        return value >= 0 && value < (int)ManagedDoom.WeaponType.Count;
    }

    private static bool IsValidAmmoTypeValue( int value )
    {
        return value >= 0 && value < (int)ManagedDoom.AmmoType.Count;
    }

    private static bool IsAuthoritativePvpProjectile( ManagedDoom.Mobj projectile )
    {
        return projectile is not null
            && (projectile.Flags & ManagedDoom.MobjFlags.Missile) != 0
            && projectile.Target?.Player is not null
            && (projectile.Type == ManagedDoom.MobjType.Rocket
                || projectile.Type == ManagedDoom.MobjType.Plasma
                || projectile.Type == ManagedDoom.MobjType.Bfg);
    }

    private static int ResolveProjectileOwnerIndex( ManagedDoom.Mobj source )
    {
        return source?.Player?.Number ?? -1;
    }

    private static int CompareProjectileSnapshots( PvpProjectileSnapshot left, PvpProjectileSnapshot right )
    {
        var result = left.OwnerPlayerIndex.CompareTo( right.OwnerPlayerIndex );
        if ( result != 0 )
        {
            return result;
        }

        result = ((int)left.Type).CompareTo( (int)right.Type );
        if ( result != 0 )
        {
            return result;
        }

        result = left.X.CompareTo( right.X );
        if ( result != 0 )
        {
            return result;
        }

        result = left.Y.CompareTo( right.Y );
        if ( result != 0 )
        {
            return result;
        }

        return left.Z.CompareTo( right.Z );
    }

    private List<PvpProjectileSnapshot> ParseProjectileSnapshots( string projectileState )
    {
        var results = new List<PvpProjectileSnapshot>();
        if ( string.IsNullOrWhiteSpace( projectileState ) )
        {
            return results;
        }

        var entries = projectileState.Split( ';', StringSplitOptions.RemoveEmptyEntries );
        for ( var i = 0; i < entries.Length; i++ )
        {
            var parts = entries[i].Split( ':', StringSplitOptions.None );
            if ( parts.Length != 10 )
            {
                continue;
            }

            if ( !int.TryParse( parts[0], out var ownerPlayerIndex )
                || !int.TryParse( parts[1], out var typeValue )
                || !Enum.IsDefined( typeof( ManagedDoom.MobjType ), typeValue )
                || !int.TryParse( parts[2], out var x )
                || !int.TryParse( parts[3], out var y )
                || !int.TryParse( parts[4], out var z )
                || !int.TryParse( parts[5], out var momX )
                || !int.TryParse( parts[6], out var momY )
                || !int.TryParse( parts[7], out var momZ )
                || !int.TryParse( parts[8], out var angle )
                || !int.TryParse( parts[9], out var tics ) )
            {
                continue;
            }

            results.Add( new PvpProjectileSnapshot
            {
                OwnerPlayerIndex = ownerPlayerIndex,
                Type = (ManagedDoom.MobjType)typeValue,
                X = x,
                Y = y,
                Z = z,
                MomX = momX,
                MomY = momY,
                MomZ = momZ,
                Angle = angle,
                Tics = tics
            } );
        }

        results.Sort( CompareProjectileSnapshots );
        return results;
    }

    private int FindBestMatchingProjectileIndex(
        List<ManagedDoom.Mobj> localProjectiles,
        bool[] matchedLocalProjectiles,
        PvpProjectileSnapshot snapshot )
    {
        var bestIndex = -1;
        long bestDistance = long.MaxValue;

        for ( var i = 0; i < localProjectiles.Count; i++ )
        {
            if ( matchedLocalProjectiles[i] )
            {
                continue;
            }

            var projectile = localProjectiles[i];
            if ( projectile.Type != snapshot.Type || ResolveProjectileOwnerIndex( projectile.Target ) != snapshot.OwnerPlayerIndex )
            {
                continue;
            }

            var dx = (long)projectile.X.Data - snapshot.X;
            var dy = (long)projectile.Y.Data - snapshot.Y;
            var dz = (long)projectile.Z.Data - snapshot.Z;
            var distance = dx * dx + dy * dy + dz * dz;

            if ( distance < bestDistance )
            {
                bestDistance = distance;
                bestIndex = i;
            }
        }

        return bestIndex;
    }

    private void ApplyProjectileSnapshot( ManagedDoom.World world, ManagedDoom.Mobj projectile, PvpProjectileSnapshot snapshot )
    {
        if ( snapshot.OwnerPlayerIndex >= 0
            && snapshot.OwnerPlayerIndex < _doom.Options.Players.Length
            && _doom.Options.Players[snapshot.OwnerPlayerIndex]?.Mobj is not null )
        {
            projectile.Target = _doom.Options.Players[snapshot.OwnerPlayerIndex].Mobj;
        }

        var thingMovement = world.ThingMovement;
        thingMovement.UnsetThingPosition( projectile );
        projectile.X = new ManagedDoom.Fixed( snapshot.X );
        projectile.Y = new ManagedDoom.Fixed( snapshot.Y );
        projectile.Z = new ManagedDoom.Fixed( snapshot.Z );
        projectile.MomX = new ManagedDoom.Fixed( snapshot.MomX );
        projectile.MomY = new ManagedDoom.Fixed( snapshot.MomY );
        projectile.MomZ = new ManagedDoom.Fixed( snapshot.MomZ );
        projectile.Angle = new ManagedDoom.Angle( snapshot.Angle );
        projectile.Tics = Math.Max( 1, snapshot.Tics );
        thingMovement.SetThingPosition( projectile );
        projectile.FloorZ = projectile.Subsector.Sector.FloorHeight;
        projectile.CeilingZ = projectile.Subsector.Sector.CeilingHeight;
        projectile.DisableFrameInterpolationForOneFrame();
    }

    private static int ParseIntOrDefault( string value, int fallback )
    {
        return int.TryParse( value, out var parsed ) ? parsed : fallback;
    }

    private void ApplyAuthoritativePlayerState( SboxManagedDoomMultiplayerSessionComponent session, int playerIndex )
    {
        var players = _doom.Options.Players;
        if ( playerIndex < 0 || playerIndex >= players.Length )
        {
            return;
        }

        var player = players[playerIndex];
        if ( player?.Mobj is null )
        {
            return;
        }

        bool active;
        int x;
        int y;
        int z;
        int momX;
        int momY;
        int momZ;
        int angle;
        int health;
        int playerStateValue;
        int armorPoints;
        int armorType;
        int ammoClip;
        int ammoShell;
        int ammoCell;
        int ammoMissile;
        bool backpack;
        bool cardBlueCard;
        bool cardYellowCard;
        bool cardRedCard;
        bool cardBlueSkull;
        bool cardYellowSkull;
        bool cardRedSkull;
        int powerInvulnerability;
